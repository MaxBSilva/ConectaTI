<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ConectaTI</AssemblyName>
    <ApplicationIcon>Assets\conectati.ico</ApplicationIcon>
    <Product>ConectaTI</Product>
    <AssemblyTitle>ConectaTI — Gerenciador de Conexões para Suporte de TI</AssemblyTitle>
    <Description>Gerenciador de conexões remotas (Área de Trabalho Remota MSTSC, SSH, WinSCP e VNC) para equipes de suporte de TI.</Description>
    <Authors>Max Silva</Authors>
    <Company>Max Silva</Company>
    <Copyright>Copyright © 2026 Max Silva</Copyright>
    <RepositoryUrl>https://github.com/MaxBSilva/ConectaTI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\conectati.ico" />
    <Resource Include="Assets\conectati.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

</Project>
