<Window x:Class="ConectaTI.App.MainWindow"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ConectaTI.App.ViewModels"
        xmlns:models="clr-namespace:ConectaTI.App.Models"
        xmlns:helpers="clr-namespace:ConectaTI.App.Helpers"
        mc:Ignorable="d"
        Title="ConectaTI"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="620" Height="500"
        MinWidth="480" MinHeight="380"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanConverter x:Key="InverseBool"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <helpers:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
        <helpers:EnvironmentToBadgeBrushConverter x:Key="EnvBadgeBrush"/>
        <helpers:FavoriteStarTextConverter x:Key="FavStarText"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Barra Superior Compacta -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Área Central (Lista à Esquerda / Formulário à Direita) -->
            <RowDefinition Height="*"/>
            <!-- 2: Barra de Status Discreta -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- BARRA SUPERIOR COMPACTA                                                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="{DynamicResource HeaderPadding}">
                <!-- Toda a largura fica disponível para comandos, com quebra natural. -->
                <WrapPanel x:Name="HeaderActions" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewConnectionButton_Click"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="{DynamicResource ButtonPadding}"
                            Margin="0,2,6,2"
                            ToolTip="{loc:Loc Text9BB1328098A8}"
                            AutomationProperties.Name="{loc:Loc TextC9DC78D19188}">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextBADD8CCF4A67}" FontSize="{DynamicResource Font12_5}"/>
                    </Button>

                    <Button Command="{Binding ToggleThemeCommand}"
                            Padding="{DynamicResource HeaderButtonPadding}"
                            Margin="0,2,6,2"
                            Background="#1E293B"
                            Foreground="#F8FAFC"
                            BorderBrush="#334155"
                            ToolTip="{Binding ThemeToggleToolTip}"
                            AutomationProperties.Name="{loc:Loc TextA7B73FF6C5D1}">
                        <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="{DynamicResource Font12_5}"/>
                    </Button>

                    <Button Click="BatchEdit_Click" IsEnabled="{Binding CanBatchEdit}" Margin="0,2,6,2" Padding="{DynamicResource ButtonPadding}">
                        <TextBlock Text="{loc:Loc Text3B11819721B7}" TextWrapping="Wrap"/>
                    </Button>
                    <TextBlock Text="{Binding SelectedAccessCountText}" VerticalAlignment="Center" Foreground="#F8FAFC" Margin="0,2,8,2" TextWrapping="Wrap"/>
                    <Button x:Name="SettingsGearButton"
                            Click="OpenSettingsButton_Click"
                            Margin="0,2,0,2"
                            Padding="{DynamicResource ButtonPadding}"
                            Background="#1E293B"
                            Foreground="#F8FAFC"
                            BorderBrush="#334155"
                            ToolTip="{loc:Loc Text76B0FB6AD189}"
                            AutomationProperties.Name="{loc:Loc Text76B0FB6AD189}">
                        <TextBlock Text="⚙" FontSize="{DynamicResource Font13}"/>
                    </Button>
                </WrapPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ÁREA CENTRAL COM 2 PAINÉIS (LISTA À ESQUERDA / FORMULÁRIO À DIREITA)       -->
        <!-- ========================================================================= -->
        <Grid x:Name="MainWorkspace" Grid.Row="1" SizeChanged="MainWorkspace_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="220" MinWidth="130"/>
                <ColumnDefinition x:Name="PaneSplitterColumnDef" Width="4"/>
                <ColumnDefinition x:Name="RightColumnDef" Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- PAINEL ESQUERDO: Campo "Buscar..." + Lista Compacta de Conexões        -->
            <!-- ===================================================================== -->
            <Grid x:Name="AccessListPane" Grid.Column="0" Background="{DynamicResource SurfaceBrush}" SizeChanged="AccessListPane_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Campo compacto "Buscar..." com botão de limpar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="{DynamicResource HeaderButtonPadding}"
                                     FontSize="{DynamicResource Font12_5}"
                                     ToolTip="{loc:Loc Text013F5E45ED6C}"
                                     AutomationProperties.Name="{loc:Loc Text5F55EDF90089}"/>

                            <TextBlock TextWrapping="Wrap" Grid.Column="0"
                                       Text="{loc:Loc Text0160E76C91E7}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="{DynamicResource Font12_5}"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Click="ClearSearchTextOnly_Click"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Padding="5,2"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Text9F3EBBDE555A}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Pílulas compactas de visualização: Todos, Favoritos, Recentes, Lixeira -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="4,3">
                    <Grid>
                    <Button x:Name="ViewModeMenuButton" Visibility="Collapsed" Click="ViewModeMenuButton_Click"
                            Padding="{DynamicResource CopyButtonPadding}" HorizontalContentAlignment="Stretch"
                            ToolTip="{Binding CurrentViewModeLabel}" AutomationProperties.Name="{loc:Loc ViewModesLabel}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text=" ▾"/>
                            <TextBlock Text="{Binding CurrentViewModeLabel}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc TextBD02B9A7D71D}" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ConnectionViewMode.All}"/>
                                <MenuItem Header="{Binding FavoritesButtonLabel}" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ConnectionViewMode.Favorites}"/>
                                <MenuItem Header="{loc:Loc Text4E6C1551840F}" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ConnectionViewMode.Recent}"/>
                                <MenuItem Header="{Binding TrashButtonLabel}" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:ConnectionViewMode.Trash}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <UniformGrid x:Name="ViewModeButtons" Columns="2">
                        <UniformGrid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Setter.Value></Setter>
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="{loc:Loc TextBD02B9A7D71D}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.All}"
                                FontSize="{DynamicResource Font10_5}"
                                Padding="{DynamicResource FilterButtonPadding}"
                                Margin="1,0"
                                ToolTip="{loc:Loc TextB3977B864159}"/>
                        <Button Content="{Binding FavoritesButtonLabel}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.Favorites}"
                                FontSize="{DynamicResource Font10_5}"
                                Padding="{DynamicResource FilterButtonPadding}"
                                Margin="1,0"
                                ToolTip="{loc:Loc TextFEA0D3D1588C}"/>
                        <Button Content="{loc:Loc Text4E6C1551840F}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.Recent}"
                                FontSize="{DynamicResource Font10_5}"
                                Padding="{DynamicResource FilterButtonPadding}"
                                Margin="1,0"
                                ToolTip="{loc:Loc TextC62B898F85F9}"/>
                        <Button Content="{Binding TrashButtonLabel}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.Trash}"
                                FontSize="{DynamicResource Font10_5}"
                                Padding="{DynamicResource FilterButtonPadding}"
                                Margin="1,0"
                                ToolTip="{loc:Loc TextF4A70EAE5B48}"/>
                    </UniformGrid>
                    </Grid>
                </Border>

                <!-- Lista Compacta: Apenas nomes de identificação das conexões e badges de ambiente -->
                <ListBox x:Name="ConnectionsListBox" SelectionMode="Extended" SelectionChanged="ConnectionsListBox_SelectionChanged"
                         IsTextSearchEnabled="False"
                         Grid.Row="2"
                         ItemsSource="{Binding FilteredConnections}"
                         SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderThickness="0"
                         PreviewMouseRightButtonDown="ConnectionsListBox_RightClick"
                         MouseDoubleClick="ConnectionsListBox_MouseDoubleClick"
                         PreviewMouseDown="ConnectionsListBox_PreviewMouseDown"
                         LostKeyboardFocus="ConnectionsListBox_LostKeyboardFocus"
                         PreviewTextInput="ConnectionsListBox_PreviewTextInput"
                         PreviewKeyDown="ConnectionsListBox_PreviewKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Text3B0B0FDFE2E3}" Click="MenuConnect_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc Text88F77287CBDB}" Click="MenuDuplicate_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc Text8B19518FF49B}" Click="MenuDelete_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc TextD222A8EA2FB8}" Click="MenuRestore_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc Text4164CBC3F186}" Click="MenuDelete_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc TextD7017B73BD1E}" Click="MenuEmptyTrash_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc TextE5F454CC6361}" Click="MenuTestConnection_Click"/>
                            <MenuItem Header="{loc:Loc Text51FC562A8C0A}" Click="MenuCopyAddressOnly_Click" IsEnabled="{Binding CanCopySelectedAddress}"/>
                            <MenuItem Header="{loc:Loc TextF401E192756A}" Click="MenuCopyPersistedUser_Click" IsEnabled="{Binding CanCopyPersistedUser}"/>
                            <MenuItem Header="{loc:Loc Text298A26FABB25}" Click="MenuCopyPassword_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="{DynamicResource ConnectionItemPadding}"/><Setter Property="MinHeight" Value="{DynamicResource ConnectionItemMinHeight}"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Margin="2,1">
                                <Border DockPanel.Dock="Right"
                                        Visibility="{Binding HasEnvironmentBadge, Converter={StaticResource BoolToVis}}"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="4,0,2,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceAltBrush}">
                                    <TextBlock Text="{Binding EnvironmentBadge}"
                                               FontSize="{DynamicResource Font9}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Font12_5}"
                                           Padding="2,3"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Name}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Barra de Status da Busca Incremental (AutoPuTTY) -->
                <Border Grid.Row="3"
                        Visibility="{Binding IncrementalSearchStatus, Converter={StaticResource StringNotEmptyToVis}}"
                        Background="{DynamicResource AccentBrush}"
                        Padding="{DynamicResource CopyButtonPadding}">
                    <TextBlock Text="{Binding IncrementalSearchStatus}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontSize="{DynamicResource Font11}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Divisória Redimensionável -->
            <GridSplitter x:Name="PaneSplitter" Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          DragCompleted="PaneSplitter_DragCompleted"
                          Cursor="SizeWE"
                          ToolTip="{loc:Loc TextFA6E89A3EFC8}"/>

            <!-- ===================================================================== -->
            <!-- PAINEL DIREITO: Formulário Fixo com Edição Direta                     -->
            <!-- ===================================================================== -->
            <Border x:Name="AccessDetailsPane" Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="DetailsScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{DynamicResource DetailPanePadding}"
                              Focusable="False">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding NewDrafts}" SelectedItem="{Binding SelectedNewDraft, Mode=TwoWay}"
                                  ToolTip="{loc:Loc TextB50E4138B1C1}" Margin="0,0,0,8"
                                  AutomationProperties.Name="{loc:Loc TextF82BFA5FF80D}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewDrafts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Text" Value="Novo cadastro (rascunho)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Faixa de Aviso e Ações quando o item está na Lixeira -->
                        <Border Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"
                                Background="#451A03"
                                BorderBrush="#D97706"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{DynamicResource SectionPadding}"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextEC97782257F3}" FontWeight="SemiBold" Foreground="#FDE68A" FontSize="{DynamicResource Font12_5}"/>
                                    <TextBlock Text="{Binding SelectedConnection.DeletedAtDisplay}" Foreground="#FDE68A" FontSize="{DynamicResource Font11}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Center" Margin="0,6,0,0">
                                    <Button Content="{loc:Loc Text010AD8D3A1F4}"
                                            Command="{Binding RestoreSelectedConnectionCommand}"
                                            Padding="{DynamicResource ButtonPadding}" Margin="0,0,6,4" FontSize="{DynamicResource Font11_5}"/>
                                    <Button Content="{loc:Loc Text37045D507711}"
                                            Command="{Binding DeleteConnectionCommand}"
                                            Background="#7F1D1D" Foreground="#FEE2E2" BorderBrush="#EF4444"
                                            Padding="{DynamicResource ButtonPadding}" Margin="0,0,0,4" FontSize="{DynamicResource Font11_5}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- 1. Nome da Conexão + Copiar -->
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextBF09C0A4277F}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="{DynamicResource FieldLabelMargin}"/>
                        <Grid Margin="{DynamicResource FieldGroupMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnectionNameTextBox"
                                     Grid.Column="0"
                                     Text="{Binding EditingEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{DynamicResource Font12_5}"
                                     Padding="{DynamicResource FieldPadding}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyConnectionNameCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc TextF32697AC9339}"
                                    AutomationProperties.Name="{loc:Loc TextD63850D3A222}">
                                <TextBlock Text="📋" FontSize="{DynamicResource Font11}"/>
                            </Button>
                        </Grid>

                        <!-- 2. Endereço / Hostname[:porta] + Copiar -->
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text134E55471D20}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="{DynamicResource FieldLabelMargin}"/>
                        <Grid Margin="{DynamicResource FieldGroupMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InlineHostAndPort, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     FontSize="{DynamicResource Font12_5}"
                                     Padding="{DynamicResource FieldPadding}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyHostCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc TextADCA1D03FBAC}"
                                    AutomationProperties.Name="{loc:Loc TextADCA1D03FBAC}">
                                <TextBlock Text="📋" FontSize="{DynamicResource Font11}"/>
                            </Button>
                        </Grid>

                        <!-- 3. Usuário [DOMÍNIO\usuário] + Copiar -->
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextB8EFA018467E}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="{DynamicResource FieldLabelMargin}"/>
                        <Grid Margin="{DynamicResource FieldGroupMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InlineUserWithDomain, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{DynamicResource Font12_5}"
                                     Padding="{DynamicResource FieldPadding}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyUsernameCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc TextF401E192756A}"
                                    AutomationProperties.Name="{loc:Loc TextF401E192756A}">
                                <TextBlock Text="📋" FontSize="{DynamicResource Font11}"/>
                            </Button>
                        </Grid>

                        <!-- 4. Senha (Mascarada, Mostrar/Ocultar, Copiar, Indicação, Remover) -->
                        <WrapPanel Margin="{DynamicResource FieldLabelMargin}">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextD482C10B3D4D}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <!-- Indicação discreta de senha salva / marcada para remoção -->
                            <TextBlock Text="{Binding SavedPasswordBadgeText}" TextWrapping="Wrap"
                                       FontSize="{DynamicResource Font11}"
                                       Foreground="{Binding PasswordStateBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>

                            <!-- Ação explícita para remover senha existente -->
                            <Button Content="{loc:Loc TextA3037DC71A43}"
                                    Click="RemovePasswordButton_Click"
                                    Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right"
                                    Padding="6,1"
                                    FontSize="{DynamicResource Font10_5}"
                                    Margin="4,0,0,0"
                                    ToolTip="{loc:Loc Text86509F57E908}"/>
                        </WrapPanel>

                        <Grid Margin="{DynamicResource FieldGroupMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Campo Mascarado (PasswordBox) -->
                            <Grid Grid.Column="0" Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVis}}">
                                <PasswordBox x:Name="InlinePasswordBox"
                                             PasswordChanged="InlinePasswordBox_PasswordChanged"
                                             FontSize="{DynamicResource Font12_5}"
                                             Padding="{DynamicResource FieldPadding}"/>
                                <TextBlock x:Name="PasswordBulletsPlaceholder"
                                           Text="••••••••••••"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="9,0,0,0"
                                           FontSize="{DynamicResource Font13}"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </Grid>

                            <!-- Campo Revelado em Texto Puro (quando acionado o botão de olho) -->
                            <TextBox x:Name="RevealedPasswordTextBox"
                                     Grid.Column="0"
                                     TextChanged="RevealedPasswordTextBox_TextChanged"
                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVis}}"
                                     FontSize="{DynamicResource Font12_5}"
                                     Padding="{DynamicResource FieldPadding}"/>

                            <!-- Botão Mostrar / Ocultar Senha -->
                            <Button Grid.Column="1"
                                    Click="TogglePasswordRevealButton_Click"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc TextB2236FABE665}">
                                <TextBlock Text="👁" FontSize="{DynamicResource Font12}"/>
                            </Button>

                            <!-- Botão Copiar Senha (funciona mesmo mascarada, cofre desbloqueado, limpa em 30s) -->
                            <Button Grid.Column="2"
                                    Command="{Binding CopyPasswordCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Text236F9B72F9D6}"
                                    AutomationProperties.Name="{loc:Loc Text298A26FABB25}">
                                <TextBlock Text="📋" FontSize="{DynamicResource Font11}"/>
                            </Button>
                        </Grid>

                        <!-- 5. Chave Privada (visível para SSH e WinSCP; oculta para MSTSC e VNC) -->
                        <StackPanel Visibility="{Binding SupportsPrivateKey, Converter={StaticResource BoolToVis}}" Margin="{DynamicResource FieldGroupMargin}">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextE6E1B71770FE}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="{DynamicResource FieldLabelMargin}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditingEntry.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{DynamicResource Font12}"
                                         Padding="{DynamicResource FieldPadding}"/>
                                <Button Grid.Column="1"
                                        Content="..."
                                        Click="BrowsePrivateKey_Click"
                                        Padding="{DynamicResource ButtonPadding}"
                                        Margin="4,0,0,0"
                                        ToolTip="{loc:Loc TextCBC206F5964B}"/>
                            </Grid>
                        </StackPanel>

                        <!-- 6. Tipo de Conexão -->
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text2FC429DB7583}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="{DynamicResource FieldLabelMargin}"/>
                        <ComboBox ItemsSource="{Binding ConnectionTypeOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedConnectionType, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <!-- 7. Ações Principais: Conectar, Salvar e Menu discreto (•••) -->
                        <WrapPanel x:Name="DetailActions" Margin="0,0,0,2">
                            <!-- Conectar (Botão Principal em Destaque) -->
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding ConnectCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Padding="{DynamicResource ActionButtonPadding}"
                                    Margin="0,0,8,6"
                                    ToolTip="{loc:Loc Text76D0D8DA1D7C}"
                                    AutomationProperties.Name="{loc:Loc Text3B0B0FDFE2E3}">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text3B0B0FDFE2E3}" FontSize="{DynamicResource Font13}" FontWeight="SemiBold"/>
                            </Button>

                            <!-- Salvar -->
                            <Button x:Name="SaveConnectionButton" DockPanel.Dock="Left"
                                    Click="SaveButton_Click"
                                    IsEnabled="{Binding CanSave}"
                                    Padding="{DynamicResource ActionButtonPadding}"
                                    Margin="0,0,8,6"
                                    ToolTip="{loc:Loc TextCFB546213C60}"
                                    AutomationProperties.Name="{loc:Loc TextAEF7CD5B2081}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                                <Setter Property="Foreground" Value="#1C1917"/>
                                                <Setter Property="BorderBrush" Value="#D97706"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding SaveButtonText}" TextWrapping="Wrap" FontSize="{DynamicResource Font12_5}"/>
                            </Button>

                            <!-- Menu Discreto para Duplicar, Excluir e Testar Conexão -->
                            <Button x:Name="MoreActionsButton"
                                    DockPanel.Dock="Left"
                                    Click="MoreActionsButton_Click"
                                    Padding="{DynamicResource ActionButtonPadding}"
                                    Margin="0,0,0,6"
                                    ToolTip="{loc:Loc Text289CA5B692D9}">
                                <TextBlock Text="•••" FontSize="{DynamicResource Font12}" FontWeight="Bold"/>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MoreActionsMenu">
                                        <MenuItem Header="{loc:Loc Text38101476AF05}" Click="MenuDuplicate_Click"/>
                                        <MenuItem Header="{loc:Loc Text138CC6F361D2}" Click="MenuDelete_Click"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:Loc TextE5F454CC6361}" Click="MenuTestConnection_Click"/>
                                        <MenuItem Header="{loc:Loc Text94B925D07059}" Click="MenuCopyHostPort_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </WrapPanel>

                        <Button x:Name="CopyCompleteAccessButton" Command="{Binding CopyCompleteAccessCommand}"
                                Padding="{DynamicResource ActionButtonPadding}" Margin="0,0,0,12" HorizontalContentAlignment="Center"
                                AutomationProperties.Name="{loc:Loc CopyCompleteAccess}">
                            <TextBlock Text="{loc:Loc CopyCompleteAccess}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Button>

                        <TextBlock Text="{Binding PendingChangesText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource Font11}" Margin="0,0,0,6"/>
                        <Button Content="{loc:Loc Text534C4DA81431}" Command="{Binding CancelEditCommand}"
                                IsEnabled="{Binding CanDiscardChanges}"
                                Visibility="{Binding CanDiscardChanges, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" Margin="{DynamicResource FieldGroupMargin}" Padding="{DynamicResource ButtonPadding}"/>

                        <!-- 8. "Mais opções" (Expander recolhido por padrão) -->
                        <Expander Header="{loc:Loc Text5D951376C42F}"
                                  IsExpanded="False"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  FontSize="{DynamicResource Font12}"
                                  Margin="{DynamicResource FieldGroupMargin}">
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="{DynamicResource SectionPadding}"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <!-- Cliente e Grupo -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextF851D9A83AB0}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding EditingEntry.ClientName, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font12}" Padding="{DynamicResource FieldPadding}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text399B037DAB0F}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding EditingEntry.GroupName, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font12}" Padding="{DynamicResource FieldPadding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Ambiente e Favorito -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text0D2B7CA65666}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <ComboBox ItemsSource="{Binding EnvironmentSelectorOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding EditingEntry.Environment, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="{DynamicResource Font12}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="{loc:Loc TextE7A2C0C4DBFB}"
                                                  IsChecked="{Binding EditingEntry.IsFavorite, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Bottom"
                                                  Margin="0,0,0,6"/>
                                    </Grid>

                                    <!-- Observações -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextC01DDBEAAB7C}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="{DynamicResource Font12}"
                                             Margin="0,0,0,8"/>

                                    <!-- Opções Específicas de RDP (MSTSC) -->
                                    <StackPanel Visibility="{Binding IsRdpSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text8F804E33755B}" FontSize="{DynamicResource Font11}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox Content="{loc:Loc TextCDD35DEA1EE3}" IsChecked="{Binding EditingEntry.RdpFullScreen, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                            <CheckBox Content="{loc:Loc Text101BBBFD9127}" IsChecked="{Binding EditingEntry.RdpUseMultimon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                            <CheckBox Content="{loc:Loc Text2E55394916E0}" IsChecked="{Binding EditingEntry.RdpAdminSession, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <Grid IsEnabled="{Binding EditingEntry.RdpFullScreen, Converter={StaticResource InverseBool}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text5D6A22D7076B}" FontSize="{DynamicResource Font10_5}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding EditingEntry.RdpWidth, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font11_5}" Padding="4,2"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text196624F8AC36}" FontSize="{DynamicResource Font10_5}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding EditingEntry.RdpHeight, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font11_5}" Padding="4,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Opções Específicas de SSH -->
                                    <StackPanel Visibility="{Binding IsSshSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                        <CheckBox Content="{loc:Loc TextF2FE19B9DB31}"
                                                  IsChecked="{Binding EditingEntry.SshUseAgent, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Opções Específicas de VNC -->
                                    <StackPanel Visibility="{Binding IsVncSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text7B3218B5EEBD}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditingEntry.VncParameters, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font12}" Padding="{DynamicResource FieldPadding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Bloco Opcional: VPN do cliente -->
                        <Expander IsExpanded="False"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  FontSize="{DynamicResource Font12}"
                                  Margin="{DynamicResource FieldGroupMargin}">
                            <Expander.Header>
                                <DockPanel HorizontalAlignment="Stretch">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text0120E59D18C6}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EditingEntry.VpnStatusBadge}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource Font11}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Expander.Header>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="{DynamicResource SectionPadding}"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <!-- Nome da VPN -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextA4A2EF0A67A1}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource Font12}"
                                                 Padding="{DynamicResource FieldPadding}"/>
                                        <Button Grid.Column="1"
                                                Content="📋"
                                                ToolTip="{loc:Loc TextFDADA95F7ABC}"
                                                Command="{Binding CopyVpnNameCommand}"
                                                Padding="{DynamicResource CopyButtonPadding}"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Aplicativo -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text23ECCE63EAEA}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.VpnApp, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="{DynamicResource Font12}"
                                             Padding="{DynamicResource FieldPadding}"
                                             Margin="0,0,0,8"/>

                                    <!-- Servidor / IP[:porta] -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text28E4CE98A862}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnServer, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="{DynamicResource Font12}"
                                                 Padding="{DynamicResource FieldPadding}"/>
                                        <Button Grid.Column="1"
                                                Content="📋"
                                                ToolTip="{loc:Loc TextD23258F58F26}"
                                                Command="{Binding CopyVpnServerCommand}"
                                                Padding="{DynamicResource CopyButtonPadding}"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Observações -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextC01DDBEAAB7C}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.VpnNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="45"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="{DynamicResource Font12}"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Resultado do Teste de Diagnóstico (quando acionado) -->
                        <Border Visibility="{Binding DiagnosticResultTitle, Converter={StaticResource StringNotEmptyToVis}}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DiagnosticResultTitle}" FontWeight="SemiBold" FontSize="{DynamicResource Font11_5}"/>
                                <TextBlock Text="{Binding DiagnosticResultDetails}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource Font11}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- BARRA DE STATUS DISCRETA                                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource ButtonPadding}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="{DynamicResource Font11_5}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
