                                    Margin="0,0,8,4"
                                    ToolTip="{loc:Loc Text660D5FC169FE}"
                                    AutomationProperties.Name="{loc:Loc Text7967C2DF48CA}">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text7967C2DF48CA}" FontSize="{DynamicResource Font12_5}" FontWeight="SemiBold"/>
                            </Button>

                            <!-- Salvar (com destaque âmbar e texto explícito quando há alterações pendentes) -->
