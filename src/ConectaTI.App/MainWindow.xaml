                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Text236F9B72F9D6}"
                                    AutomationProperties.Name="{loc:Loc Text298A26FABB25}">
                                <TextBlock Text="📋" FontSize="{DynamicResource Font11}"/>
                            </Button>
                        </Grid>

                        <!-- 5. Chave Privada (visível para SSH e WinSCP; oculta para MSTSC e VNC) -->
                        <StackPanel Visibility="{Binding SupportsPrivateKey, Converter={StaticResource BoolToVis}}" Margin="{DynamicResource FieldSpacingMargin}">
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="{loc:Loc TextE6E1B71770FE}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditingEntry.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="{DynamicResource Font12}"/>
