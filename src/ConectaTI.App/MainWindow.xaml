                                    Margin="0,0,8,4"
                                    ToolTip="{loc:Loc TextCFB546213C60}"
                                    AutomationProperties.Name="{loc:Loc TextAEF7CD5B2081}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
