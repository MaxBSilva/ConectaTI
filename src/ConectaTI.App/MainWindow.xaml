                                Margin="0,0,0,12">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextEC97782257F3}" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource Font12_5}"/>
                                    <TextBlock Text="{Binding SelectedConnection.DeletedAtDisplay}" Foreground="{DynamicResource WarningTextBrush}" FontSize="{DynamicResource Font11}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{loc:Loc Text010AD8D3A1F4}"
                                            Command="{Binding RestoreSelectedConnectionCommand}"
                                            Padding="10,4" Margin="0,0,6,0" FontSize="{DynamicResource Font11_5}"/>
                                    <Button Content="{loc:Loc Text37045D507711}"
                                            Command="{Binding DeleteConnectionCommand}"
                                            Background="{DynamicResource DangerSurfaceBrush}"
                                            Foreground="{DynamicResource DangerBrush}"
                                            BorderBrush="{DynamicResource DangerBorderBrush}"
                                            Padding="10,4" FontSize="{DynamicResource Font11_5}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 1. Nome da Conexão + Estado Ativo/Inativo + Copiar -->
                        <DockPanel Margin="0,0,0,3">
