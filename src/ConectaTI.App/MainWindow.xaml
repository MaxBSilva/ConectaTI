            </GridSplitter>

            <!-- ===================================================================== -->
            <!-- PAINEL DIREITO: Formulário Estruturado da Conexão Selecionada         -->
            <!-- ===================================================================== -->
            <Border x:Name="ConnectionDetailsBorder"
                    Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
