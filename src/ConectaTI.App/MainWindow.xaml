                                <Setter TargetName="SplitterLine" Property="Background" Value="{DynamicResource FocusBorderBrush}"/>
                                <Setter TargetName="SplitterLine" Property="Opacity" Value="1.0"/>
                                <Setter TargetName="SplitterGrip" Property="Width" Value="3.5"/>
                                <Setter TargetName="SplitterGrip" Property="Background" Value="{DynamicResource FocusBorderBrush}"/>
                                <Setter TargetName="SplitterGrip" Property="Opacity" Value="1.0"/>
