<Window x:Class="ConectaTI.App.MainWindow"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ConectaTI.App.ViewModels"
        xmlns:models="clr-namespace:ConectaTI.App.Models"
        xmlns:helpers="clr-namespace:ConectaTI.App.Helpers"
        mc:Ignorable="d"
        Title="ConectaTI"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="620" Height="500"
        MinWidth="480" MinHeight="380"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanConverter x:Key="InverseBool"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <helpers:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
        <helpers:EnvironmentToBadgeBrushConverter x:Key="EnvBadgeBrush"/>
        <helpers:FavoriteStarTextConverter x:Key="FavStarText"/>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid" Background="{DynamicResource AppBackgroundBrush}" SizeChanged="RootLayoutGrid_SizeChanged">
        <Grid.RowDefinitions>
            <!-- 0: Barra Superior Compacta e Responsiva -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Área Central (Lista à Esquerda / Formulário à Direita Sempre Lado a Lado) -->
            <RowDefinition Height="*"/>
            <!-- 2: Barra de Status Discreta -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- BARRA SUPERIOR COMPACTA E RESPONSIVA                                      -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="True">
                <!-- Direita: Aparência (Tema Sol/Lua) e Configurações (Engrenagem) claramente diferenciados -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Command="{Binding ToggleThemeCommand}"
                            Style="{DynamicResource HeaderSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="{Binding ThemeToggleToolTip}"
                            AutomationProperties.Name="{loc:Loc TextA7B73FF6C5D1}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="13" Height="13" Stretch="Uniform" Fill="#FBBF24" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <!-- Sol nítido com centro sólido e raios separados no modo escuro; lua crescente no modo claro -->
                                        <Setter Property="Data" Value="M 8,4.2 A 3.8,3.8 0 1 1 7.99,4.2 Z M 7.2,0 H 8.8 V 2.3 H 7.2 Z M 7.2,13.7 H 8.8 V 16 H 7.2 Z M 0,7.2 H 2.3 V 8.8 H 0 Z M 13.7,7.2 H 16 V 8.8 H 13.7 Z M 1.9,3.0 L 3.0,1.9 L 4.7,3.6 L 3.6,4.7 Z M 11.3,12.4 L 12.4,11.3 L 14.1,13.0 L 13.0,14.1 Z M 13.0,1.9 L 14.1,3.0 L 12.4,4.7 L 11.3,3.6 Z M 3.6,11.3 L 4.7,12.4 L 3.0,14.1 L 1.9,13.0 Z"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ThemeToggleIcon}" Value="🌙">
                                                <Setter Property="Data" Value="M 9.5,1 A 7,7 0 1 0 15,11.2 A 5.5,5.5 0 1 1 9.5,1 Z"/>
                                                <Setter Property="Fill" Value="#38BDF8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock x:Name="ThemeButtonLabel" Text="{loc:Loc Text04F9F0A78DBE}" TextWrapping="Wrap" Margin="5,0,0,0" FontSize="{DynamicResource Font12}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsGearButton"
                            Click="OpenSettingsButton_Click"
                            Style="{DynamicResource HeaderSecondaryButtonStyle}"
                            ToolTip="{loc:Loc Text76B0FB6AD189}"
                            AutomationProperties.Name="{loc:Loc Text76B0FB6AD189}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="SettingsGearIconPath"
                                  Width="15"
                                  Height="15"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True"
                                  VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="F0 M 10.2,0.8 L 13.8,0.8 L 14.3,3.7 A 8.4,8.4 0 0 1 16.2,4.5 L 18.6,2.8 L 21.2,5.4 L 19.5,7.8 A 8.4,8.4 0 0 1 20.3,9.7 L 23.2,10.2 L 23.2,13.8 L 20.3,14.3 A 8.4,8.4 0 0 1 19.5,16.2 L 21.2,18.6 L 18.6,21.2 L 16.2,19.5 A 8.4,8.4 0 0 1 14.3,20.3 L 13.8,23.2 L 10.2,23.2 L 9.7,20.3 A 8.4,8.4 0 0 1 7.8,19.5 L 5.4,21.2 L 2.8,18.6 L 4.5,16.2 A 8.4,8.4 0 0 1 3.7,14.3 L 0.8,13.8 L 0.8,10.2 L 3.7,9.7 A 8.4,8.4 0 0 1 4.5,7.8 L 2.8,5.4 L 5.4,2.8 L 7.8,4.5 A 8.4,8.4 0 0 1 9.7,3.7 Z M 12,7.8 A 4.2,4.2 0 1 0 12,16.2 A 4.2,4.2 0 1 0 12,7.8 Z"/>
                            <TextBlock x:Name="SettingsButtonLabel" Text="{loc:Loc Text76B0FB6AD189}" TextWrapping="Wrap" Margin="5,0,0,0" FontSize="{DynamicResource Font12}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Esquerda: Ação Primária (+ Nova) + Ações Secundárias e Menu de Ações Adicionais -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewConnectionButton"
                            Click="NewConnectionButton_Click"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            ToolTip="{loc:Loc Text9BB1328098A8}"
                            AutomationProperties.Name="{loc:Loc TextC9DC78D19188}">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextBADD8CCF4A67}" FontSize="{DynamicResource Font12_5}"/>
                    </Button>

                    <Button x:Name="ImportRdpButton"
                            Content="{loc:Loc Text7A379B5A9C3F}"
                            Click="ImportRdp_Click"
                            Style="{DynamicResource HeaderSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="{loc:Loc Text5AD394933E8E}"/>

                    <Button x:Name="BatchEditButton"
                            Content="{loc:Loc Text3B11819721B7}"
                            Click="BatchEdit_Click"
                            IsEnabled="{Binding CanBatchEdit}"
                            Style="{DynamicResource HeaderSecondaryButtonStyle}"
                            Margin="0,0,6,0"/>

                    <Button x:Name="QuickTextsButton"
                            Content="{loc:Loc TextAE29611184C1}"
                            Click="QuickTextsButton_Click"
                            Style="{DynamicResource HeaderSecondaryButtonStyle}"
                            Margin="0,0,6,0"
                            ToolTip="{loc:Loc TextC61ED4CDBFAA}"
                            AutomationProperties.Name="{loc:Loc TextAE29611184C1}"/>

                    <TextBlock x:Name="HeaderSelectionBadge"
                               Text="{Binding SelectedAccessCountText}"
                               VerticalAlignment="Center"
                               Foreground="#CBD5E1"
                               FontSize="{DynamicResource Font11_5}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="150"
                               Margin="0,0,6,0"/>

                    <Button x:Name="TopOverflowButton"
                            Click="TopOverflowButton_Click"
                            Style="{DynamicResource HeaderSecondaryButtonStyle}"
                            ToolTip="{loc:Loc Text01581BD379D3}"
                            AutomationProperties.Name="{loc:Loc Text01581BD379D3}">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text3BBF2C614563}" FontSize="{DynamicResource Font12}"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="TopOverflowMenu">
                                <MenuItem Header="{loc:Loc TextAE29611184C1}" Click="QuickTextsButton_Click"/>
                                <MenuItem x:Name="MenuToggleThemeItem" Header="{loc:Loc Text04F9F0A78DBE}" Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToggleToolTip}"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Text7A379B5A9C3F}" Click="ImportRdp_Click"/>
                                <MenuItem Header="{loc:Loc Text3B11819721B7}" Click="BatchEdit_Click" IsEnabled="{Binding CanBatchEdit}"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Text9ECAAA06B087}" Click="OpenImportExportFromHeader_Click"/>
                                <MenuItem Header="{loc:Loc TextF68E4F381086}" Click="OpenCredentialsFromHeader_Click"/>
                                <Separator/>
                                <MenuItem Header="{loc:Loc Text5519670C5987}" Click="OpenShortcutsTab_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ÁREA CENTRAL COM PAINÉIS LADO A LADO + ABA/PAINEL DE TEXTOS RÁPIDOS       -->
        <!-- ========================================================================= -->
        <Grid x:Name="CentralWorkspaceGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="220" MinWidth="130"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="RightColumnDef" Width="*" MinWidth="260"/>
                <ColumnDefinition x:Name="QuickTextsColumnDef" Width="0"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- PAINEL ESQUERDO: Campo "Buscar..." + Filtros + Lista Compacta         -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Campo compacto "Buscar..." com ícone e botão de limpar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="⌕"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,1"
                                       FontSize="{DynamicResource Font13}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       IsHitTestVisible="False"/>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="5,4"
                                     FontSize="{DynamicResource Font12_5}"
                                     ToolTip="{loc:Loc Text013F5E45ED6C}"
                                     AutomationProperties.Name="{loc:Loc Text5F55EDF90089}"/>

                            <TextBlock TextWrapping="Wrap" Grid.Column="1"
                                       Text="{loc:Loc Text0160E76C91E7}"
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0"
                                       FontSize="{DynamicResource Font12_5}"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <Button Grid.Column="2"
                                    Content="✕"
                                    Click="ClearSearchTextOnly_Click"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Padding="5,2"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{loc:Loc Text9F3EBBDE555A}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Pílulas compactas de visualização e filtro de situação (Todos / Ativos / Inativos) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="4,4">
                    <Border.Resources>
                        <Style x:Key="ViewModeFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="FontSize" Value="{DynamicResource Font10_5}"/>
                            <Setter Property="Padding" Value="2,3"/>
                            <Setter Property="Margin" Value="1,1"/>
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <Button Content="{loc:Loc TextBD02B9A7D71D}"
                                    Command="{Binding SetViewModeCommand}"
                                    CommandParameter="{x:Static models:ConnectionViewMode.All}"
                                    ToolTip="{loc:Loc TextB3977B864159}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ConnectionViewMode.All}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{Binding FavoritesButtonLabel}"
                                    Command="{Binding SetViewModeCommand}"
                                    CommandParameter="{x:Static models:ConnectionViewMode.Favorites}"
                                    ToolTip="{loc:Loc TextFEA0D3D1588C}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ConnectionViewMode.Favorites}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{loc:Loc Text4E6C1551840F}"
                                    Command="{Binding SetViewModeCommand}"
                                    CommandParameter="{x:Static models:ConnectionViewMode.Recent}"
                                    ToolTip="{loc:Loc TextC62B898F85F9}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ConnectionViewMode.Recent}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="{Binding TrashButtonLabel}"
                                    Command="{Binding SetViewModeCommand}"
                                    CommandParameter="{x:Static models:ConnectionViewMode.Trash}"
                                    ToolTip="{loc:Loc TextF4A70EAE5B48}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentViewMode}" Value="{x:Static models:ConnectionViewMode.Trash}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,3,0,0">
                            <Button x:Name="ActivityAllFilterButton"
                                    Content="{loc:Loc TextBD02B9A7D71D}"
                                    Command="{Binding SetActivityFilterCommand}"
                                    CommandParameter="{x:Static models:ConnectionActivityFilter.All}"
                                    ToolTip="{loc:Loc TextE765CE3080E6}"
                                    AutomationProperties.Name="{loc:Loc TextE765CE3080E6}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActivityFilter}" Value="{x:Static models:ConnectionActivityFilter.All}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="ActivityActiveFilterButton"
                                    Content="{loc:Loc Text46E6638C8237}"
                                    Command="{Binding SetActivityFilterCommand}"
                                    CommandParameter="{x:Static models:ConnectionActivityFilter.Active}"
                                    ToolTip="{loc:Loc TextB5E3F368C3BC}"
                                    AutomationProperties.Name="{loc:Loc TextB5E3F368C3BC}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActivityFilter}" Value="{x:Static models:ConnectionActivityFilter.Active}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="ActivityInactiveFilterButton"
                                    Content="{loc:Loc Text11995DC6D958}"
                                    Command="{Binding SetActivityFilterCommand}"
                                    CommandParameter="{x:Static models:ConnectionActivityFilter.Inactive}"
                                    ToolTip="{loc:Loc Text89F016F41CBB}"
                                    AutomationProperties.Name="{loc:Loc Text89F016F41CBB}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ViewModeFilterButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentActivityFilter}" Value="{x:Static models:ConnectionActivityFilter.Inactive}">
                                                <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Lista Compacta: Nomes de identificação das conexões, estado Ativo/Inativo e badges -->
                <ListBox x:Name="ConnectionsListBox" SelectionMode="Extended" SelectionChanged="ConnectionsListBox_SelectionChanged"
                         IsTextSearchEnabled="False"
                         PreviewMouseLeftButtonDown="ConnectionsListBox_PreviewMouseLeftButtonDown"
                         Grid.Row="2"
                         ItemsSource="{Binding FilteredConnections}"
                         SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderThickness="0"
                         PreviewMouseRightButtonDown="ConnectionsListBox_RightClick"
                         MouseDoubleClick="ConnectionsListBox_MouseDoubleClick"
                         PreviewKeyDown="ConnectionsListBox_PreviewKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Text3B0B0FDFE2E3}" Click="MenuConnect_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc Text88F77287CBDB}" Click="MenuDuplicate_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc Text8B19518FF49B}" Click="MenuDelete_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc TextD222A8EA2FB8}" Click="MenuRestore_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc Text4164CBC3F186}" Click="MenuDelete_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{loc:Loc TextD7017B73BD1E}" Click="MenuEmptyTrash_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Text7967C2DF48CA}" Click="MenuOpenVpn_Click" IsEnabled="{Binding CanOpenVpnClient}"/>
                            <MenuItem Header="{loc:Loc TextE5F454CC6361}" Click="MenuTestConnection_Click"/>
                            <MenuItem Header="{loc:Loc Text51FC562A8C0A}" Click="MenuCopyAddressOnly_Click" IsEnabled="{Binding CanCopySelectedAddress}"/>
                            <MenuItem Header="{loc:Loc TextF401E192756A}" Click="MenuCopyPersistedUser_Click" IsEnabled="{Binding CanCopyPersistedUser}"/>
                            <MenuItem Header="{loc:Loc Text298A26FABB25}" Click="MenuCopyPassword_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="{DynamicResource ConnectionItemPadding}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Margin="2,1" ToolTip="{Binding Name}">
                                <Border Width="3" CornerRadius="1.5" Margin="0,1,5,1" Background="{DynamicResource DangerBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="★"
                                               Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"
                                               Foreground="{DynamicResource WarningBrush}"
                                               FontSize="{DynamicResource Font10_5}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,2,0"/>
                                    <Border Visibility="{Binding HasEnvironmentBadge, Converter={StaticResource BoolToVis}}"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Margin="3,0,2,0"
                                            VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <TextBlock Text="{Binding EnvironmentBadge}"
                                                   FontSize="{DynamicResource Font9}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                    <Border Background="{DynamicResource DangerSurfaceBrush}"
                                            BorderBrush="{DynamicResource DangerBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="4,1"
                                            Margin="3,0,2,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ActivityDisplay}" Foreground="{DynamicResource DangerBrush}" FontSize="{DynamicResource Font9}" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Font12_5}"
                                           Padding="2,2"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsActive}" Value="False"/>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Foreground" Value="{DynamicResource InactiveSelectedTextBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
