                                                <TextBlock Text="{loc:Loc TextB31D65B1D31E}" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding EditingEntry.RdpOptions.GatewayProfileUsageMethod, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="{loc:Loc Text265299E22025}" IsChecked="{Binding EditingEntry.RdpOptions.PromptCredentialOnce, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="{loc:Loc TextF4B780D1F8D6}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="{loc:Loc Text3312B550641E}" Margin="0,0,0,8">
                                            <StackPanel Margin="4">
                                                <StackPanel.Resources>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                                                        <Setter Property="FontSize" Value="{DynamicResource Font11}"/>
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                        <Setter Property="Margin" Value="0,4,0,3"/>
                                                    </Style>
                                                </StackPanel.Resources>
                                                <TextBlock Text="{loc:Loc Text3021412EFCE9}" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding EditingEntry.RdpOptions.AdditionalProperties, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="{DynamicResource RdpAdvancedHeight}" VerticalScrollBarVisibility="Auto"/>
                                                <TextBlock Text="{loc:Loc TextD958F8E91014}" TextWrapping="Wrap"/>
                                                <TextBox Text="{Binding EditingEntry.RdpOptions.OriginalContent, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="{DynamicResource RdpOriginalHeight}" VerticalScrollBarVisibility="Auto"/>
                                                <Button Content="{loc:Loc TextE79A3E4B7661}" Click="RdpDiagnostics_Click" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text8F804E33755B}" FontSize="{DynamicResource Font11}" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox Content="{loc:Loc TextCDD35DEA1EE3}" IsChecked="{Binding EditingEntry.RdpFullScreen, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                            <CheckBox Content="{loc:Loc Text101BBBFD9127}" IsChecked="{Binding EditingEntry.RdpUseMultimon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                            <CheckBox Content="{loc:Loc Text2E55394916E0}" IsChecked="{Binding EditingEntry.RdpAdminSession, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <Grid IsEnabled="{Binding EditingEntry.RdpFullScreen, Converter={StaticResource InverseBool}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text5D6A22D7076B}" FontSize="{DynamicResource Font10_5}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding EditingEntry.RdpWidth, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font11_5}" Padding="4,2"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text196624F8AC36}" FontSize="{DynamicResource Font10_5}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding EditingEntry.RdpHeight, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font11_5}" Padding="4,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Opções Específicas de SSH -->
                                    <StackPanel Visibility="{Binding IsSshSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                        <CheckBox Content="{loc:Loc TextF2FE19B9DB31}"
                                                  IsChecked="{Binding EditingEntry.SshUseAgent, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Opções Específicas de VNC -->
                                    <StackPanel Visibility="{Binding IsVncSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text7B3218B5EEBD}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditingEntry.VncParameters, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font12}" Padding="5,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Bloco Opcional: VPN do cliente -->
                        <Expander IsExpanded="False"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  FontSize="{DynamicResource Font12}"
                                  Margin="0,0,0,10">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text0120E59D18C6}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EditingEntry.VpnStatusBadge}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="{DynamicResource Font11}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>
                            <Border Style="{DynamicResource SectionCardBorderStyle}" Margin="0,4,0,0">
                                <StackPanel>
                                    <!-- Nome da VPN / Perfil (.ovpn) -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextA4A2EF0A67A1}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VpnNameTextBox"
                                                 Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource Font12}"
                                                 Padding="5,3"/>
                                        <Button x:Name="VpnProfilePresetButton"
                                                Grid.Column="1"
                                                Content="▾"
                                                Click="VpnProfilePresetButton_Click"
                                                Padding="7,3"
                                                Margin="4,0,0,0"
                                                ToolTip="{loc:Loc TextCB278E7A042A}"/>
                                        <Button Grid.Column="2"
                                                Content="📋"
                                                ToolTip="{loc:Loc TextFDADA95F7ABC}"
                                                Command="{Binding CopyVpnNameCommand}"
                                                Padding="6,3"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Aplicativo -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text23ECCE63EAEA}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VpnAppTextBox"
                                                 Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnApp, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource Font12}"
                                                 Padding="5,3"/>
                                        <Button x:Name="VpnAppPresetButton"
                                                Grid.Column="1"
                                                Content="▾"
                                                Click="VpnAppPresetButton_Click"
                                                Padding="7,3"
                                                Margin="4,0,0,0"
                                                ToolTip="{loc:Loc Text57349A09D81B}"/>
                                        <Button x:Name="BrowseVpnAppButton"
                                                Grid.Column="2"
                                                Content="..."
                                                Click="BrowseVpnApp_Click"
                                                Padding="8,3"
                                                Margin="4,0,0,0"
                                                ToolTip="{loc:Loc Text0D4B69604D7F}"/>
                                    </Grid>

                                    <!-- Servidor / IP[:porta] -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text28E4CE98A862}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnServer, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="{DynamicResource Font12}"
                                                 Padding="5,3"/>
                                        <Button Grid.Column="1"
                                                Content="📋"
                                                ToolTip="{loc:Loc TextD23258F58F26}"
                                                Command="{Binding CopyVpnServerCommand}"
                                                Padding="6,3"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Usuário da VPN (manual e opcional — preenche apenas se a VPN pedir) -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextA9428D95E85A}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="VpnUsernameTextBox"
                                                 Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnUsername, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="{DynamicResource Font12}"
                                                 Padding="5,3"/>
                                        <Button Grid.Column="1"
                                                Content="📋"
                                                Command="{Binding CopyVpnUsernameCommand}"
                                                IsEnabled="{Binding CanCopyVpnUsername}"
                                                Padding="6,3"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"
                                                ToolTip="{loc:Loc TextE912424FC627}"/>
                                    </Grid>

                                    <!-- Senha da VPN (manual e opcional — criptografada no cofre ao salvar) -->
                                    <WrapPanel Margin="0,0,0,3">
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{Binding VpnPasswordFieldLabel}"
                                                   FontSize="{DynamicResource Font11}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <Border CornerRadius="3"
                                                Padding="5,1"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VpnPasswordStatusIcon}"
                                                           FontSize="{DynamicResource Font10_5}"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding VpnPasswordStateBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding SavedVpnPasswordBadgeText}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{DynamicResource Font10_5}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding VpnPasswordStateBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Content="{loc:Loc TextA3037DC71A43}"
                                                Click="RemoveVpnPasswordButton_Click"
                                                Visibility="{Binding HasSavedVpnPassword, Converter={StaticResource BoolToVis}}"
                                                Padding="6,1"
                                                FontSize="{DynamicResource Font10_5}"
                                                Margin="6,0,0,0"
                                                ToolTip="{loc:Loc TextAEA32E14CAD0}"/>
                                    </WrapPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Campo Mascarado (PasswordBox da VPN) -->
                                        <Grid Grid.Column="0" Visibility="{Binding IsVpnPasswordRevealed, Converter={StaticResource InverseBoolToVis}}">
                                            <PasswordBox x:Name="InlineVpnPasswordBox"
                                                         PasswordChanged="InlineVpnPasswordBox_PasswordChanged"
                                                         FontSize="{DynamicResource Font12}"/>
                                            <TextBlock x:Name="VpnPasswordBulletsPlaceholder"
                                                       Text="••••••••••••"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="9,0,0,0"
                                                       FontSize="{DynamicResource Font12_5}"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>

                                        <!-- Campo Revelado em Texto Puro (quando acionado o botão de olho da VPN) -->
                                        <TextBox x:Name="RevealedVpnPasswordTextBox"
                                                 Grid.Column="0"
                                                 TextChanged="RevealedVpnPasswordTextBox_TextChanged"
                                                 Visibility="{Binding IsVpnPasswordRevealed, Converter={StaticResource BoolToVis}}"
                                                 FontSize="{DynamicResource Font12}"/>

                                        <!-- Botão Mostrar / Ocultar Senha da VPN -->
                                        <Button Grid.Column="1"
                                                Click="ToggleVpnPasswordRevealButton_Click"
                                                Style="{DynamicResource IconCopyButtonStyle}"
                                                Margin="4,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:Loc Text7806256BFFFE}">
                                            <TextBlock Text="👁" FontSize="{DynamicResource Font12}"/>
                                        </Button>

                                        <!-- Botão Copiar Senha da VPN -->
                                        <Button Grid.Column="2"
                                                Command="{Binding CopyVpnPasswordCommand}"
                                                IsEnabled="{Binding CanCopyVpnPassword}"
                                                Style="{DynamicResource IconCopyButtonStyle}"
                                                Margin="2,0,0,0"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:Loc Text719170742EB5}">
                                            <TextBlock Text="📋" FontSize="{DynamicResource Font11}"/>
                                        </Button>
                                    </Grid>

                                    <!-- Observações -->
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextC01DDBEAAB7C}" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.VpnNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="{DynamicResource VpnNotesHeight}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="{DynamicResource Font12}"
                                             Margin="0,0,0,8"/>

                                    <Button x:Name="OpenVpnCardButton"
                                            Content="{loc:Loc Text7967C2DF48CA}"
                                            Command="{Binding OpenVpnClientCommand}"
                                            Background="{DynamicResource SuccessSurfaceBrush}"
                                            BorderBrush="{DynamicResource SuccessBrush}"
                                            Foreground="{DynamicResource SuccessBrush}"
                                            HorizontalAlignment="Left"
                                            Padding="12,5"
                                            FontWeight="SemiBold"
                                            ToolTip="{loc:Loc Text660D5FC169FE}"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Resultado do Teste de Diagnóstico (quando acionado) -->
                        <Border Visibility="{Binding DiagnosticResultTitle, Converter={StaticResource StringNotEmptyToVis}}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DiagnosticResultTitle}" FontWeight="SemiBold" FontSize="{DynamicResource Font11_5}"/>
                                <TextBlock Text="{Binding DiagnosticResultDetails}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource Font11}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================================================================== -->
            <!-- PAINEL RETRÁTIL DE TEXTOS RÁPIDOS (HotKeyText Integrado)               -->
            <!-- Em janela larga fica na Coluna 3; em janela estreita abre sobre a     -->
            <!-- Coluna 2 (detalhes), mantendo a lista de acessos (Coluna 0) acessível -->
            <!-- ===================================================================== -->
            <Border x:Name="QuickTextsSidePanel"
                    Grid.Column="3"
                    Panel.ZIndex="20"
                    Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="145"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 0: Cabeçalho do Painel + Botão Recolher -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <Button x:Name="QuickTextsCollapseButton"
                                DockPanel.Dock="Right"
                                Content="Recolher ▸"
                                Click="QuickTextsCollapseButton_Click"
                                Padding="8,3"
                                FontSize="{DynamicResource Font11}"
                                VerticalAlignment="Top"
                                ToolTip="Recolher o painel mantendo Scroll Lock e atalhos ativos (Esc)"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border CornerRadius="4" Width="18" Height="18" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="H" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{loc:Loc TextAE29611184C1}" FontWeight="SemiBold" FontSize="{DynamicResource Font13}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="QuickTextsSubheaderText"
                                       FontSize="{DynamicResource Font10_5}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 1: Aviso de Conflito com Edição Avulsa (exibido somente quando detectado) -->
                    <Border x:Name="QuickTextsConflictBanner"
                            Grid.Row="1"
                            Visibility="Collapsed"
                            Background="{DynamicResource WarningSurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8,6"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="QuickTextsConflictTextBlock"
                                       TextWrapping="Wrap"
                                       FontSize="{DynamicResource Font11}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningTextBrush}"/>
                            <Button x:Name="QuickTextsRetryActivateButton"
                                    Content="Ativar atalhos integrados"
                                    Click="QuickTextsRetryActivateButton_Click"
                                    HorizontalAlignment="Left"
                                    Padding="8,3"
                                    FontSize="{DynamicResource Font11}"
                                    Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2: Lista de Textos Cadastrados -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="2">
                        <ListBox x:Name="QuickTextsListBox"
                                 SelectionMode="Single"
                                 SelectionChanged="QuickTextsListBox_SelectionChanged"
                                 MouseDoubleClick="QuickTextsListBox_MouseDoubleClick"
                                 AutomationProperties.Name="Lista de textos rápidos">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Border DockPanel.Dock="Left"
                                                CornerRadius="4"
                                                MinWidth="24"
                                                Padding="6,2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource AccentBrush}">
                                            <TextBlock Text="{Binding EffectiveShortcut}"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource Font10_5}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource Font11_5}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DisplayPreview}"
                                                       FontSize="{DynamicResource Font10_5}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- 3: Barra de Ações da Lista (+ Novo, Excluir, Ordenar ▲/▼, Inserir) -->
                    <WrapPanel Grid.Row="3" Margin="0,6,0,6">
                        <Button x:Name="QuickTextsNewButton"
                                Content="+ Novo"
                                Click="QuickTextsNewButton_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="9,3"
                                FontSize="{DynamicResource Font11}"
                                Margin="0,0,5,3"/>
                        <Button x:Name="QuickTextsDeleteButton"
                                Content="Excluir"
                                Click="QuickTextsDeleteButton_Click"
                                Padding="8,3"
                                FontSize="{DynamicResource Font11}"
                                Margin="0,0,5,3"/>
                        <Button x:Name="QuickTextsMoveUpButton"
                                Content="▲"
                                Click="QuickTextsMoveUpButton_Click"
                                Padding="7,3"
                                FontSize="{DynamicResource Font11}"
                                Margin="0,0,4,3"
                                ToolTip="Mover texto para cima"/>
                        <Button x:Name="QuickTextsMoveDownButton"
                                Content="▼"
                                Click="QuickTextsMoveDownButton_Click"
                                Padding="7,3"
                                FontSize="{DynamicResource Font11}"
                                Margin="0,0,5,3"
                                ToolTip="Mover texto para baixo"/>
                        <Button x:Name="QuickTextsInsertNowButton"
                                Content="Inserir agora"
                                Click="QuickTextsInsertNowButton_Click"
                                Padding="8,3"
                                FontSize="{DynamicResource Font11}"
                                Margin="0,0,0,3"
                                ToolTip="Inserir o texto selecionado na última janela de destino ativa"/>
                    </WrapPanel>

                    <!-- 4: Editor do Texto Selecionado (Título, Atalho, Exibir texto e Conteúdo) -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título e Atalho lado a lado -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Título" Margin="0,0,0,2"/>
                                <TextBox x:Name="QuickTextTitleBox"
                                         TextChanged="QuickTextTitleBox_TextChanged"
                                         FontSize="{DynamicResource Font12}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Atalho" Margin="0,0,0,2"/>
                                <TextBox x:Name="QuickTextShortcutBox"
                                         IsReadOnly="True"
                                         TextAlignment="Center"
                                         FontWeight="SemiBold"
                                         Cursor="Hand"
                                         GotKeyboardFocus="QuickTextShortcutBox_GotKeyboardFocus"
                                         LostKeyboardFocus="QuickTextShortcutBox_LostKeyboardFocus"
                                         PreviewKeyDown="QuickTextShortcutBox_PreviewKeyDown"
                                         FontSize="{DynamicResource Font11_5}"
                                         ToolTip="Clique e pressione a tecla ou combinação desejada (ex.: 1, Shift+1, Ctrl+2)"/>
                            </StackPanel>
                            <Button x:Name="QuickTextDefaultShortcutButton"
                                    Grid.Column="2"
                                    Content="Padrão"
                                    Click="QuickTextDefaultShortcutButton_Click"
                                    VerticalAlignment="Bottom"
                                    Padding="7,5"
                                    FontSize="{DynamicResource Font11}"
                                    ToolTip="Restaurar atalho padrão da posição (1–9, 0, A–Z)"/>
                        </Grid>

                        <!-- Rótulo do Conteúdo + Opção de Exibir/Ocultar prévia -->
                        <DockPanel Grid.Row="1" Margin="0,0,0,3">
                            <CheckBox x:Name="QuickTextShowContentCheckBox"
                                      DockPanel.Dock="Right"
                                      Content="Exibir texto"
                                      IsChecked="True"
                                      Click="QuickTextShowContentCheckBox_Click"
                                      FontSize="{DynamicResource Font11}"
                                      VerticalAlignment="Center"
                                      ToolTip="Desmarque para ocultar prévia e mascarar texto sensível"/>
                            <TextBlock Style="{StaticResource FieldLabelTextStyle}" Text="Texto a inserir" Margin="0" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Caixa de Conteúdo (visível ou mascarada) -->
                        <Grid Grid.Row="2">
                            <TextBox x:Name="QuickTextContentBox"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     TextChanged="QuickTextContentBox_TextChanged"
                                     FontSize="{DynamicResource Font12}"/>
                            <PasswordBox x:Name="QuickTextMaskedContentBox"
                                         Visibility="Collapsed"
                                         PasswordChanged="QuickTextMaskedContentBox_PasswordChanged"
                                         FontSize="{DynamicResource Font12}"/>
                        </Grid>
                    </Grid>

                    <!-- 5: Rodapé com Tecla de abertura, Modo (Digitar vs Colar) e Iniciar com o Windows -->
                    <Border Grid.Row="5"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Margin="0,8,0,0"
                            Padding="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Text589F01A36BD9}" FontWeight="SemiBold" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="QuickTextTriggerKeyBox"
                                         Grid.Column="0"
                                         IsReadOnly="True"
                                         Cursor="Hand"
                                         TextAlignment="Center"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         FontSize="{DynamicResource Font11}"
                                         GotKeyboardFocus="QuickTextTriggerKeyBox_GotKeyboardFocus"
                                         LostKeyboardFocus="QuickTextTriggerKeyBox_LostKeyboardFocus"
                                         PreviewKeyDown="QuickTextTriggerKeyBox_PreviewKeyDown"
                                         ToolTip="{loc:Loc Text966A3E719813}"/>
                                <Button x:Name="QuickTextDefaultTriggerButton"
                                        Grid.Column="1"
                                        Content="{loc:Loc Text0758C00E6EA0}"
                                        Click="QuickTextDefaultTriggerButton_Click"
                                        Padding="7,3"
                                        Margin="4,0,0,0"
                                        FontSize="{DynamicResource Font11}"
                                        ToolTip="{loc:Loc TextFB9843DB7123}"/>
                            </Grid>
                            <TextBlock Text="Modo de inserção:" FontWeight="SemiBold" FontSize="{DynamicResource Font11}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                            <RadioButton x:Name="QuickTextModeTypeRadio"
                                         Content="Digitar (usa Colar automaticamente em WTS/RDP)"
                                         Checked="QuickTextModeRadio_Checked"
                                         FontSize="{DynamicResource Font11}"
                                         Margin="0,0,0,3"/>
                            <RadioButton x:Name="QuickTextModePasteRadio"
                                         Content="Sempre colar pela área de transferência"
                                         Checked="QuickTextModeRadio_Checked"
                                         FontSize="{DynamicResource Font11}"
                                         Margin="0,0,0,5"/>
                            <CheckBox x:Name="QuickTextStartWithWindowsCheckBox"
                                      Content="Iniciar com o Windows"
                                      Click="QuickTextStartWithWindowsCheckBox_Click"
                                      FontSize="{DynamicResource Font11}"/>
                            <Button x:Name="QuickTextsCheckUpdatesButton"
                                    Content="{loc:Loc Text2A2A2B8CE89E}"
                                    Click="QuickTextsCheckUpdatesButton_Click"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    FontSize="{DynamicResource Font11}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===================================================================== -->
            <!-- ABA NA BORDA DIREITA: Abre e recolhe o painel "Textos rápidos"        -->
            <!-- ===================================================================== -->
            <Border x:Name="QuickTextsEdgeTabBorder"
                    Grid.Column="4"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Button x:Name="QuickTextsEdgeTabButton"
                        Click="QuickTextsEdgeTabButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        ToolTip="{loc:Loc TextC61ED4CDBFAA}"
                        AutomationProperties.Name="{loc:Loc TextAE29611184C1}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="QuickTextsEdgeTabArrow"
                                   Text="◂"
                                   FontSize="{DynamicResource Font11}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>
                        <TextBlock x:Name="QuickTextsEdgeTabLabel"
                                   Text="{loc:Loc TextAE29611184C1}"
                                   FontSize="{DynamicResource Font11_5}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- BARRA DE STATUS DISCRETA                                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="{DynamicResource Font11_5}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
