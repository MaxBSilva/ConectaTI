                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="{DynamicResource FormPadding}"
                              Focusable="False">
                    <StackPanel>
                        <!-- Seletor de Rascunhos Não Salvos (visível quando há rascunhos novos em memória) -->
