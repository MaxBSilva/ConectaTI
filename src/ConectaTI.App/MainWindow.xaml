<Window x:Class="ConectaTI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ConectaTI.App.ViewModels"
        xmlns:models="clr-namespace:ConectaTI.App.Models"
        xmlns:helpers="clr-namespace:ConectaTI.App.Helpers"
        mc:Ignorable="d"
        Title="ConectaTI"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="620" Height="500"
        MinWidth="480" MinHeight="380"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanConverter x:Key="InverseBool"/>
        <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <helpers:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis"/>
        <helpers:EnvironmentToBadgeBrushConverter x:Key="EnvBadgeBrush"/>
        <helpers:FavoriteStarTextConverter x:Key="FavStarText"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Barra Superior Compacta -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Área Central (Lista à Esquerda / Formulário à Direita) -->
            <RowDefinition Height="*"/>
            <!-- 2: Barra de Status Discreta -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- BARRA SUPERIOR COMPACTA                                                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- Identidade Visual -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/ConectaTI;component/Assets/conectati.png"
                           Width="20" Height="20" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="ConectaTI"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Ações da Barra Superior: Nova Conexão, Alternar Tema (Sol/Lua), Configurações (Engrenagem) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewConnectionButton_Click"
                            Style="{DynamicResource PrimaryButtonStyle}"
                            Padding="10,4"
                            Margin="0,0,6,0"
                            ToolTip="Cadastrar nova conexão (Ctrl+N)"
                            AutomationProperties.Name="Nova conexão">
                        <TextBlock Text="+ Nova" FontSize="12.5"/>
                    </Button>

                    <Button Command="{Binding ToggleThemeCommand}"
                            Padding="7,4"
                            Margin="0,0,6,0"
                            Background="#1E293B"
                            Foreground="#F8FAFC"
                            BorderBrush="#334155"
                            ToolTip="{Binding ThemeToggleToolTip}"
                            AutomationProperties.Name="Alternar tema">
                        <TextBlock Text="{Binding ThemeToggleIcon}" FontSize="12.5"/>
                    </Button>

                    <Button x:Name="SettingsGearButton"
                            Click="OpenSettingsButton_Click"
                            Padding="8,4"
                            Background="#1E293B"
                            Foreground="#F8FAFC"
                            BorderBrush="#334155"
                            ToolTip="Configurações"
                            AutomationProperties.Name="Configurações">
                        <TextBlock Text="⚙" FontSize="13"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ÁREA CENTRAL COM 2 PAINÉIS (LISTA À ESQUERDA / FORMULÁRIO À DIREITA)       -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="220" MinWidth="130"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition x:Name="RightColumnDef" Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================================== -->
            <!-- PAINEL ESQUERDO: Campo "Buscar..." + Lista Compacta de Conexões        -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Campo compacto "Buscar..." com botão de limpar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="8,6">
                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="7,4"
                                     FontSize="12.5"
                                     ToolTip="Buscar conexão (Ctrl+F)"
                                     AutomationProperties.Name="Buscar"/>

                            <TextBlock Grid.Column="0"
                                       Text="Buscar..."
                                       Visibility="{Binding SearchText, Converter={StaticResource StringEmptyToVis}}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource MutedTextBrush}"/>

                            <Button Grid.Column="1"
                                    Content="✕"
                                    Click="ClearSearchTextOnly_Click"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Padding="5,2"
                                    Margin="0,0,2,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Limpar busca"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Pílulas compactas de visualização: Todos, Favoritos, Recentes, Lixeira -->
                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="4,3">
                    <UniformGrid Columns="4">
                        <Button Content="Todos"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.All}"
                                FontSize="10.5"
                                Padding="0,3"
                                Margin="1,0"
                                ToolTip="Todas as conexões ativas"/>
                        <Button Content="{Binding FavoritesButtonLabel}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.Favorites}"
                                FontSize="10.5"
                                Padding="0,3"
                                Margin="1,0"
                                ToolTip="Conexões marcadas como favoritas"/>
                        <Button Content="🕒 Recentes"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.Recent}"
                                FontSize="10.5"
                                Padding="0,3"
                                Margin="1,0"
                                ToolTip="Conexões abertas recentemente"/>
                        <Button Content="{Binding TrashButtonLabel}"
                                Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:ConnectionViewMode.Trash}"
                                FontSize="10.5"
                                Padding="0,3"
                                Margin="1,0"
                                ToolTip="Lixeira (conexões excluídas)"/>
                    </UniformGrid>
                </Border>

                <!-- Lista Compacta: Apenas nomes de identificação das conexões e badges de ambiente -->
                <ListBox x:Name="ConnectionsListBox"
                         Grid.Row="2"
                         ItemsSource="{Binding FilteredConnections}"
                         SelectedItem="{Binding SelectedConnection, Mode=TwoWay}"
                         SelectionMode="Single"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource SurfaceBrush}"
                         BorderThickness="0"
                         MouseDoubleClick="ConnectionsListBox_MouseDoubleClick"
                         PreviewKeyDown="ConnectionsListBox_PreviewKeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Conectar" Click="MenuConnect_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="Duplicar" Click="MenuDuplicate_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="Excluir" Click="MenuDelete_Click" Visibility="{Binding IsNotTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="Restaurar da lixeira" Click="MenuRestore_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="Excluir definitivamente" Click="MenuDelete_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="Esvaziar lixeira" Click="MenuEmptyTrash_Click" Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"/>
                            <Separator/>
                            <MenuItem Header="Testar conexão" Click="MenuTestConnection_Click"/>
                            <MenuItem Header="Copiar host:porta" Click="MenuCopyHostPort_Click"/>
                            <MenuItem Header="Copiar senha" Click="MenuCopyPassword_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True" Margin="2,1">
                                <Border DockPanel.Dock="Right"
                                        Visibility="{Binding HasEnvironmentBadge, Converter={StaticResource BoolToVis}}"
                                        CornerRadius="3"
                                        Padding="3,1"
                                        Margin="4,0,2,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceAltBrush}">
                                    <TextBlock Text="{Binding EnvironmentBadge}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12.5"
                                           Padding="2,3"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Name}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Barra de Status da Busca Incremental (AutoPuTTY) -->
                <Border Grid.Row="3"
                        Visibility="{Binding IncrementalSearchStatus, Converter={StaticResource StringNotEmptyToVis}}"
                        Background="{DynamicResource AccentBrush}"
                        Padding="6,3">
                    <TextBlock Text="{Binding IncrementalSearchStatus}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- Divisória Redimensionável -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          ShowsPreview="True"
                          Cursor="SizeWE"
                          ToolTip="Arraste para ajustar a largura da lista"/>

            <!-- ===================================================================== -->
            <!-- PAINEL DIREITO: Formulário Fixo com Edição Direta                     -->
            <!-- ===================================================================== -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14,12"
                              Focusable="False">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding NewDrafts}" SelectedItem="{Binding SelectedNewDraft, Mode=TwoWay}"
                                  ToolTip="Novos rascunhos desta sessão" Margin="0,0,0,8"
                                  AutomationProperties.Name="Novos rascunhos">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewDrafts.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Name}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Name}" Value="">
                                                        <Setter Property="Text" Value="Novo cadastro (rascunho)"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <!-- Faixa de Aviso e Ações quando o item está na Lixeira -->
                        <Border Visibility="{Binding IsTrashMode, Converter={StaticResource BoolToVis}}"
                                Background="#451A03"
                                BorderBrush="#D97706"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="0,0,0,12">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="🗑️ Conexão na Lixeira" FontWeight="SemiBold" Foreground="#FDE68A" FontSize="12.5"/>
                                    <TextBlock Text="{Binding SelectedConnection.DeletedAtDisplay}" Foreground="#FDE68A" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="♻️ Restaurar"
                                            Command="{Binding RestoreSelectedConnectionCommand}"
                                            Padding="10,4" Margin="0,0,6,0" FontSize="11.5"/>
                                    <Button Content="Excluir Definitivamente"
                                            Command="{Binding DeleteConnectionCommand}"
                                            Background="#7F1D1D" Foreground="#FEE2E2" BorderBrush="#EF4444"
                                            Padding="10,4" FontSize="11.5"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 1. Nome da Conexão + Copiar -->
                        <TextBlock Text="Nome da conexão" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConnectionNameTextBox"
                                     Grid.Column="0"
                                     Text="{Binding EditingEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12.5"
                                     Padding="7,5"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyConnectionNameCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copiar nome da conexão"
                                    AutomationProperties.Name="Copiar nome">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </Grid>

                        <!-- 2. Endereço / Hostname[:porta] + Copiar -->
                        <TextBlock Text="Endereço / Hostname[:porta]" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InlineHostAndPort, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas"
                                     FontSize="12.5"
                                     Padding="7,5"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyHostCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copiar endereço"
                                    AutomationProperties.Name="Copiar endereço">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </Grid>

                        <!-- 3. Usuário [DOMÍNIO\usuário] + Copiar -->
                        <TextBlock Text="Usuário [DOMÍNIO\usuário]" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding InlineUserWithDomain, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12.5"
                                     Padding="7,5"/>
                            <Button Grid.Column="1"
                                    Command="{Binding CopyUsernameCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copiar usuário"
                                    AutomationProperties.Name="Copiar usuário">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </Grid>

                        <!-- 4. Senha (Mascarada, Mostrar/Ocultar, Copiar, Indicação, Remover) -->
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock Text="Senha" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                            <!-- Indicação discreta de senha salva / marcada para remoção -->
                            <TextBlock Text="{Binding SavedPasswordBadgeText}"
                                       FontSize="11"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>

                            <!-- Ação explícita para remover senha existente -->
                            <Button Content="Remover"
                                    Click="RemovePasswordButton_Click"
                                    Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right"
                                    Padding="6,1"
                                    FontSize="10.5"
                                    Margin="4,0,0,0"
                                    ToolTip="Remover senha salva desta conexão"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Campo Mascarado (PasswordBox) -->
                            <Grid Grid.Column="0" Visibility="{Binding IsPasswordRevealed, Converter={StaticResource InverseBoolToVis}}">
                                <PasswordBox x:Name="InlinePasswordBox"
                                             PasswordChanged="InlinePasswordBox_PasswordChanged"
                                             FontSize="12.5"
                                             Padding="7,5"/>
                                <TextBlock x:Name="PasswordBulletsPlaceholder"
                                           Text="••••••••••••"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           Margin="9,0,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </Grid>

                            <!-- Campo Revelado em Texto Puro (quando acionado o botão de olho) -->
                            <TextBox x:Name="RevealedPasswordTextBox"
                                     Grid.Column="0"
                                     TextChanged="RevealedPasswordTextBox_TextChanged"
                                     Visibility="{Binding IsPasswordRevealed, Converter={StaticResource BoolToVis}}"
                                     FontSize="12.5"
                                     Padding="7,5"/>

                            <!-- Botão Mostrar / Ocultar Senha -->
                            <Button Grid.Column="1"
                                    Click="TogglePasswordRevealButton_Click"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Mostrar / ocultar senha">
                                <TextBlock Text="👁" FontSize="12"/>
                            </Button>

                            <!-- Botão Copiar Senha (funciona mesmo mascarada, cofre desbloqueado, limpa em 30s) -->
                            <Button Grid.Column="2"
                                    Command="{Binding CopyPasswordCommand}"
                                    Style="{DynamicResource IconCopyButtonStyle}"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copiar senha (limpa em 30 segundos)"
                                    AutomationProperties.Name="Copiar senha">
                                <TextBlock Text="📋" FontSize="11"/>
                            </Button>
                        </Grid>

                        <!-- 5. Chave Privada (visível para SSH e WinSCP; oculta para MSTSC e VNC) -->
                        <StackPanel Visibility="{Binding SupportsPrivateKey, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <TextBlock Text="Chave privada" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding EditingEntry.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         Padding="7,5"/>
                                <Button Grid.Column="1"
                                        Content="..."
                                        Click="BrowsePrivateKey_Click"
                                        Padding="8,4"
                                        Margin="4,0,0,0"
                                        ToolTip="Procurar arquivo de chave privada SSH"/>
                            </Grid>
                        </StackPanel>

                        <!-- 6. Tipo de Conexão -->
                        <TextBlock Text="Tipo de conexão" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding ConnectionTypeOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding SelectedConnectionType, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                        <!-- 7. Ações Principais: Conectar, Salvar e Menu discreto (•••) -->
                        <DockPanel Margin="0,0,0,12">
                            <!-- Conectar (Botão Principal em Destaque) -->
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding ConnectCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Padding="18,6"
                                    ToolTip="Conectar ao servidor (Enter na lista)"
                                    AutomationProperties.Name="Conectar">
                                <TextBlock Text="Conectar" FontSize="13" FontWeight="SemiBold"/>
                            </Button>

                            <!-- Salvar -->
                            <Button x:Name="SaveConnectionButton" DockPanel.Dock="Left"
                                    Click="SaveButton_Click"
                                    IsEnabled="{Binding CanSave}"
                                    Padding="14,6"
                                    Margin="8,0,0,0"
                                    ToolTip="Salvar alterações desta conexão (Ctrl+S)"
                                    AutomationProperties.Name="Salvar">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                                <Setter Property="Background" Value="#F59E0B"/>
                                                <Setter Property="Foreground" Value="#1C1917"/>
                                                <Setter Property="BorderBrush" Value="#D97706"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding SaveButtonText}" FontSize="12.5"/>
                            </Button>

                            <!-- Menu Discreto para Duplicar, Excluir e Testar Conexão -->
                            <Button x:Name="MoreActionsButton"
                                    DockPanel.Dock="Left"
                                    Click="MoreActionsButton_Click"
                                    Padding="10,6"
                                    Margin="8,0,0,0"
                                    ToolTip="Mais opções (Duplicar, Excluir, Testar)">
                                <TextBlock Text="•••" FontSize="12" FontWeight="Bold"/>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="MoreActionsMenu">
                                        <MenuItem Header="Duplicar conexão" Click="MenuDuplicate_Click"/>
                                        <MenuItem Header="Excluir conexão" Click="MenuDelete_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Testar conexão" Click="MenuTestConnection_Click"/>
                                        <MenuItem Header="Copiar host:porta" Click="MenuCopyHostPort_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </DockPanel>

                        <TextBlock Text="{Binding PendingChangesText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,0,0,6"/>
                        <Button Content="Descartar alterações" Command="{Binding CancelEditCommand}"
                                IsEnabled="{Binding CanDiscardChanges}"
                                Visibility="{Binding CanDiscardChanges, Converter={StaticResource BoolToVis}}"
                                HorizontalAlignment="Left" Margin="0,0,0,10" Padding="10,4"/>

                        <!-- 8. "Mais opções" (Expander recolhido por padrão) -->
                        <Expander Header="Mais opções"
                                  IsExpanded="False"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  FontSize="12"
                                  Margin="0,0,0,10">
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,8"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <!-- Cliente e Grupo -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="Cliente" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding EditingEntry.ClientName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="5,3"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="Grupo" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBox Text="{Binding EditingEntry.GroupName, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="5,3"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Ambiente e Favorito -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Ambiente" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <ComboBox ItemsSource="{Binding EnvironmentSelectorOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="Value"
                                                      SelectedValue="{Binding EditingEntry.Environment, UpdateSourceTrigger=PropertyChanged}"
                                                      FontSize="12"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Content="Favorito"
                                                  IsChecked="{Binding EditingEntry.IsFavorite, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Bottom"
                                                  Margin="0,0,0,6"/>
                                    </Grid>

                                    <!-- Observações -->
                                    <TextBlock Text="Observações" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="50"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12"
                                             Margin="0,0,0,8"/>

                                    <!-- Opções Específicas de RDP (MSTSC) -->
                                    <StackPanel Visibility="{Binding IsRdpSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                        <TextBlock Text="Opções RDP (MSTSC)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <WrapPanel Margin="0,0,0,6">
                                            <CheckBox Content="Tela cheia" IsChecked="{Binding EditingEntry.RdpFullScreen, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                            <CheckBox Content="Multimon" IsChecked="{Binding EditingEntry.RdpUseMultimon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,4"/>
                                            <CheckBox Content="Admin (/admin)" IsChecked="{Binding EditingEntry.RdpAdminSession, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <Grid IsEnabled="{Binding EditingEntry.RdpFullScreen, Converter={StaticResource InverseBool}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="Largura" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding EditingEntry.RdpWidth, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Padding="4,2"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <TextBlock Text="Altura" FontSize="10.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                <TextBox Text="{Binding EditingEntry.RdpHeight, UpdateSourceTrigger=PropertyChanged}" FontSize="11.5" Padding="4,2"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Opções Específicas de SSH -->
                                    <StackPanel Visibility="{Binding IsSshSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                        <CheckBox Content="Usar agente de autenticação SSH (Pageant / ssh-agent)"
                                                  IsChecked="{Binding EditingEntry.SshUseAgent, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Opções Específicas de VNC -->
                                    <StackPanel Visibility="{Binding IsVncSelected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Parâmetros adicionais VNC" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding EditingEntry.VncParameters, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="5,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Bloco Opcional: VPN do cliente -->
                        <Expander IsExpanded="False"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  FontSize="12"
                                  Margin="0,0,0,10">
                            <Expander.Header>
                                <DockPanel HorizontalAlignment="Stretch">
                                    <TextBlock Text="VPN do cliente" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EditingEntry.VpnStatusBadge}"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </Expander.Header>
                            <Border Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="10,8"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <!-- Nome da VPN -->
                                    <TextBlock Text="Nome da VPN" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnName, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="12"
                                                 Padding="5,3"/>
                                        <Button Grid.Column="1"
                                                Content="📋"
                                                ToolTip="Copiar nome da VPN"
                                                Command="{Binding CopyVpnNameCommand}"
                                                Padding="6,3"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Aplicativo -->
                                    <TextBlock Text="Aplicativo" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.VpnApp, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12"
                                             Padding="5,3"
                                             Margin="0,0,0,8"/>

                                    <!-- Servidor / IP[:porta] -->
                                    <TextBlock Text="Servidor / IP[:porta]" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditingEntry.VpnServer, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Padding="5,3"/>
                                        <Button Grid.Column="1"
                                                Content="📋"
                                                ToolTip="Copiar servidor da VPN"
                                                Command="{Binding CopyVpnServerCommand}"
                                                Padding="6,3"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"/>
                                    </Grid>

                                    <!-- Observações -->
                                    <TextBlock Text="Observações" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding EditingEntry.VpnNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="45"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalContentAlignment="Top"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Resultado do Teste de Diagnóstico (quando acionado) -->
                        <Border Visibility="{Binding DiagnosticResultTitle, Converter={StaticResource StringNotEmptyToVis}}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DiagnosticResultTitle}" FontWeight="SemiBold" FontSize="11.5"/>
                                <TextBlock Text="{Binding DiagnosticResultDetails}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- BARRA DE STATUS DISCRETA                                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
