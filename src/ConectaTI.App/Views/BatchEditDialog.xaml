<Window x:Class="ConectaTI.App.Views.BatchEditDialog"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        Title="{loc:Loc Text46C202C7E457}" Width="570" Height="470" MinWidth="470" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="SelectionCountText" FontSize="{DynamicResource Font16}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc TextD9A99F9E4EDA}" TextWrapping="Wrap" Margin="0,8,0,16"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="{loc:Loc TextF851D9A83AB0}"/>
            <ComboBox x:Name="ClientModeCombo" SelectedIndex="0" Margin="0,4,0,4">
                <ComboBoxItem Content="{loc:Loc Text21190A7FCFCB}"/><ComboBoxItem Content="{loc:Loc Text828036BF894B}"/><ComboBoxItem Content="{loc:Loc Text258ACE67BE6A}"/>
            </ComboBox>
            <TextBox x:Name="ClientValueBox" Margin="0,0,0,14"/>
            <TextBlock Text="{loc:Loc Text399B037DAB0F}"/>
            <ComboBox x:Name="GroupModeCombo" SelectedIndex="0" Margin="0,4,0,4">
                <ComboBoxItem Content="{loc:Loc Text21190A7FCFCB}"/><ComboBoxItem Content="{loc:Loc Text828036BF894B}"/><ComboBoxItem Content="{loc:Loc Text258ACE67BE6A}"/>
            </ComboBox>
            <TextBox x:Name="GroupValueBox" Margin="0,0,0,14"/>
            <CheckBox x:Name="ChangeEnvironmentCheck" Content="{loc:Loc Text319A21755771}" Margin="0,0,0,4"/>
            <ComboBox x:Name="EnvironmentCombo" SelectedIndex="0"><ComboBoxItem Content="{loc:Loc TextCCB244688314}"/><ComboBoxItem Content="{loc:Loc Text4EA947CEAF9E}"/><ComboBoxItem Content="{loc:Loc Text89F308210C7C}"/></ComboBox>
            <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel></ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyButton" Content="{loc:Loc TextE2162AD991BD}" Click="Apply_Click" Padding="14,6" Margin="0,0,8,0"/>
            <Button Content="{loc:Loc Text0F2BD88EF0AC}" Click="Close_Click" Padding="14,6"/>
        </WrapPanel>
    </Grid>
</Window>
