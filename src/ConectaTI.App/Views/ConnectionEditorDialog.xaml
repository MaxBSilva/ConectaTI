<Window x:Class="ConectaTI.App.Views.ConnectionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ConectaTI.App.Helpers"
        Title="Conexão — ConectaTI"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="540" Height="640"
        MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Cabeçalho -->
            <RowDefinition Height="Auto"/>
            <!-- Conteúdo Rolável -->
            <RowDefinition Height="*"/>
            <!-- Rodapé Fixo (Cancelar / Salvar) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="DialogTitleText" Text="Nova conexão" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Informe os dados principais da conexão." FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Campos Iniciais: Nome, Cliente, Tipo de conexão, Endereço, Usuário, Senha -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <!-- 1. Nome -->
                        <TextBlock Text="Nome" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameInputBox"
                                 Text="{Binding EditingEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <!-- 2. Cliente -->
                        <TextBlock Text="Cliente" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditingEntry.ClientName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <!-- 3. Tipo de conexão -->
                        <TextBlock Text="Tipo de conexão" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ProtocolEditCombo"
                                  ItemsSource="{Binding ProtocolSelectorOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding EditingEntry.Protocol, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="ProtocolEditCombo_SelectionChanged"
                                  Margin="0,0,0,12"/>

                        <!-- 4. Endereço -->
                        <TextBlock Text="Endereço" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditingEntry.Host, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 ToolTip="Hostname DNS, endereço IPv4 ou IPv6"
                                 Margin="0,0,0,12"/>

                        <!-- 5. Usuário -->
                        <TextBlock Text="Usuário" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditingEntry.Username, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Usuário local, DOMINIO\usuario ou usuario@dominio"
                                 Margin="0,0,0,12"/>

                        <!-- 6. Senha -->
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PasswordFieldLabel}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text=" — " FontSize="12.5" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding PasswordStatusText}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Button DockPanel.Dock="Right"
                                    Content="Remover senha salva"
                                    Command="{Binding MarkPasswordForRemovalCommand}"
                                    Visibility="{Binding CanRemoveSavedPassword, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right"
                                    Padding="8,3" FontSize="11.5"
                                    Click="RemovePasswordButton_Click"/>
                        </DockPanel>

                        <PasswordBox x:Name="InlinePasswordBox"
                                     PasswordChanged="InlinePasswordBox_PasswordChanged"
                                     ToolTip="Informe a senha para salvar ou deixe em branco para manter a senha existente"/>

                        <TextBlock Text="Deixe em branco para preservar a senha existente."
                                   FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Opções Avançadas: Porta, Domínio, Grupo, Ambiente, Chave privada, Preferências do protocolo -->
                <Expander x:Name="AdvancedExpander"
                          Header="Opções avançadas"
                          IsExpanded="False"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Margin="0,12,0,0">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- Porta e Domínio -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Porta" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingEntry.Port, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"
                                            Visibility="{Binding IsDomainApplicable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Domínio" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingEntry.Domain, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Grupo e Ambiente -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Grupo" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingEntry.GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Ambiente" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding EnvironmentSelectorOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingEntry.Environment, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Marcar como favorito"
                                      IsChecked="{Binding EditingEntry.IsFavorite, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12"/>

                            <!-- Chave Privada (apenas SSH / WinSCP) -->
                            <StackPanel Visibility="{Binding SupportsPrivateKey, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="Chave privada" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding EditingEntry.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Procurar..." Click="BrowsePrivateKey_Click" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Preferências Específicas de RDP (MSTSC) -->
                            <StackPanel Visibility="{Binding IsRdpSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Preferências de tela (MSTSC)" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="Tela cheia" IsChecked="{Binding EditingEntry.RdpFullScreen, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,6"/>
                                    <CheckBox Content="Múltiplos monitores" IsChecked="{Binding EditingEntry.RdpUseMultimon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,6"/>
                                    <CheckBox Content="Sessão admin (/admin)" IsChecked="{Binding EditingEntry.RdpAdminSession, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <Grid IsEnabled="{Binding EditingEntry.RdpFullScreen, Converter={StaticResource InverseBool}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Largura (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding EditingEntry.RdpWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Altura (px)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding EditingEntry.RdpHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Preferências Específicas de SSH -->
                            <StackPanel Visibility="{Binding IsSshSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Cliente SSH" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SshClientSelectorOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingEntry.SshClient, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="Usar agente de autenticação SSH"
                                          IsChecked="{Binding EditingEntry.SshUseAgent, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Preferências Específicas de VNC -->
                            <StackPanel Visibility="{Binding IsVncSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Parâmetros adicionais do VNC" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingEntry.VncParameters, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Observações em área opcional -->
                <Expander x:Name="NotesExpander"
                          Header="Observações"
                          IsExpanded="False"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Margin="0,10,0,4">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                        <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="76"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé: Cancelar e Salvar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="CancelButton_Click" Padding="16,7" Margin="0,0,10,0"/>
                <Button Content="Salvar" Click="SaveButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
