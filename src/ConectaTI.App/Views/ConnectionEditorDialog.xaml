<Window x:Class="ConectaTI.App.Views.ConnectionEditorDialog"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        xmlns:helpers="clr-namespace:ConectaTI.App.Helpers"
        Title="{loc:Loc TextFAA972EC1C89}"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="540" Height="640"
        MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Cabeçalho -->
            <RowDefinition Height="Auto"/>
            <!-- Conteúdo Rolável -->
            <RowDefinition Height="*"/>
            <!-- Rodapé Fixo (Cancelar / Salvar) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="DialogTitleText" Text="{loc:Loc TextC9DC78D19188}" FontSize="{DynamicResource Font17}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="{loc:Loc Text80B067419682}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Formulário -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- Campos Iniciais: Nome, Cliente, Tipo de conexão, Endereço, Usuário, Senha -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <!-- 1. Nome -->
                        <TextBlock Text="{loc:Loc Text5086900635FE}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameInputBox"
                                 Text="{Binding EditingEntry.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <!-- 2. Cliente -->
                        <TextBlock Text="{loc:Loc TextF851D9A83AB0}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditingEntry.ClientName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"/>

                        <!-- 3. Tipo de conexão -->
                        <TextBlock Text="{loc:Loc Text2FC429DB7583}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ProtocolEditCombo"
                                  ItemsSource="{Binding ProtocolSelectorOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding EditingEntry.Protocol, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="ProtocolEditCombo_SelectionChanged"
                                  Margin="0,0,0,12"/>

                        <!-- 4. Endereço -->
                        <TextBlock Text="{loc:Loc TextEF5E7E12BDAC}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditingEntry.Host, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas"
                                 ToolTip="{loc:Loc Text0A230B5DD43B}"
                                 Margin="0,0,0,12"/>

                        <!-- 5. Usuário -->
                        <TextBlock Text="{loc:Loc TextF53BBAA05FAE}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditingEntry.Username, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Text138610D10FB9}"
                                 Margin="0,0,0,12"/>

                        <!-- 6. Senha -->
                        <DockPanel Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PasswordFieldLabel}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                <TextBlock Text=" — " FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding PasswordStatusText}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}"/>
                            </StackPanel>

                            <Button DockPanel.Dock="Right"
                                    Content="{loc:Loc TextFF8E2C52F95D}"
                                    Command="{Binding MarkPasswordForRemovalCommand}"
                                    Visibility="{Binding CanRemoveSavedPassword, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Right"
                                    Padding="8,3" FontSize="{DynamicResource Font11_5}"
                                    Click="RemovePasswordButton_Click"/>
                        </DockPanel>

                        <PasswordBox x:Name="InlinePasswordBox"
                                     PasswordChanged="InlinePasswordBox_PasswordChanged"
                                     ToolTip="{loc:Loc TextD9DB020133DE}"/>

                        <TextBlock Text="{loc:Loc TextA2068A0DE3BB}"
                                   FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding HasSavedPassword, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Opções Avançadas: Porta, Domínio, Grupo, Ambiente, Chave privada, Preferências do protocolo -->
                <Expander x:Name="AdvancedExpander"
                          Header="{loc:Loc TextBD998143DA98}"
                          IsExpanded="False"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Margin="0,12,0,0">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,6,0,0">
                        <StackPanel>
                            <!-- Porta e Domínio -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Text946D1F8153CE}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingEntry.Port, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0"
                                            Visibility="{Binding IsDomainApplicable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:Loc Text356377BA453A}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingEntry.Domain, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Grupo e Ambiente -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="{loc:Loc Text399B037DAB0F}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditingEntry.GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{loc:Loc Text0D2B7CA65666}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding EnvironmentSelectorOptions}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding EditingEntry.Environment, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="{loc:Loc Text6DD8CF662565}"
                                      IsChecked="{Binding EditingEntry.IsFavorite, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,12"/>

                            <!-- Chave Privada (apenas SSH / WinSCP) -->
                            <StackPanel Visibility="{Binding SupportsPrivateKey, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="{loc:Loc TextE6E1B71770FE}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding EditingEntry.PrivateKeyPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="{loc:Loc TextB9D4506C3B66}" Click="BrowsePrivateKey_Click" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <!-- Preferências Específicas de RDP (MSTSC) -->
                            <StackPanel Visibility="{Binding IsRdpSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc Text4255EF5ED251}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <CheckBox Content="{loc:Loc TextCDD35DEA1EE3}" IsChecked="{Binding EditingEntry.RdpFullScreen, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,6"/>
                                    <CheckBox Content="{loc:Loc Text9C2447A06C8D}" IsChecked="{Binding EditingEntry.RdpUseMultimon, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,6"/>
                                    <CheckBox Content="{loc:Loc Text7A9412FE2BF6}" IsChecked="{Binding EditingEntry.RdpAdminSession, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                </WrapPanel>
                                <Grid IsEnabled="{Binding EditingEntry.RdpFullScreen, Converter={StaticResource InverseBool}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="{loc:Loc TextB11E7CA5545B}" FontSize="{DynamicResource Font12}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding EditingEntry.RdpWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="{loc:Loc TextDE73D011D72D}" FontSize="{DynamicResource Font12}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding EditingEntry.RdpHeight, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Preferências Específicas de SSH -->
                            <StackPanel Visibility="{Binding IsSshSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc Text2F06B83E3014}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SshClientSelectorOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditingEntry.SshClient, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,8"/>
                                <CheckBox Content="{loc:Loc Text15C4DC7F49C4}"
                                          IsChecked="{Binding EditingEntry.SshUseAgent, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Preferências Específicas de VNC -->
                            <StackPanel Visibility="{Binding IsVncSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:Loc Text514834825DDF}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditingEntry.VncParameters, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- Observações em área opcional -->
                <Expander x:Name="NotesExpander"
                          Header="{loc:Loc TextC01DDBEAAB7C}"
                          IsExpanded="False"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          Margin="0,10,0,4">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,6,0,0">
                        <TextBox Text="{Binding EditingEntry.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Height="76"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé: Cancelar e Salvar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc TextBB9DBB406DCB}" Click="CancelButton_Click" Padding="16,7" Margin="0,0,10,0"/>
                <Button Content="{loc:Loc TextAEF7CD5B2081}" Click="SaveButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
