<Window x:Class="ConectaTI.App.Views.ImportExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importação, Exportação e Backups"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="960" Height="680"
        MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Central de Importação, Exportação e Backups" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="O ConectaTI cria automaticamente um backup consistente do SQLite antes de qualquer importação ou restauração."
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <!-- ABA 1: IMPORTAR CSV / JSON / AUTOPUTTY -->
            <TabItem Header="📥 Importar (CSV, JSON, AutoPuTTY)" Padding="12,6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Seleção de Arquivo -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="📂 Selecionar Arquivo (CSV, JSON ou AutoPuTTY)..." Click="SelectImportFile_Click"
                                Padding="12,6" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock x:Name="SelectedFileText" Text="Nenhum arquivo selecionado." VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Painel de Mapeamento de Colunas CSV (visível quando um CSV é carregado) -->
                    <Border x:Name="CsvMappingPanel" Grid.Row="1" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Mapeamento de Colunas do CSV (ajuste caso necessário para atualizar a prévia):" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="Coluna Nome:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapNameCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="Coluna Cliente:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapClientCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="Coluna Grupo:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapGroupCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Coluna Ambiente:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapEnvCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock Text="Coluna Protocolo:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapProtocolCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock Text="Coluna Host/IP:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapHostCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock Text="Coluna Porta:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapPortCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Coluna Usuário:" FontSize="11.5"/>
                                    <ComboBox x:Name="MapUserCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Prévia dos Registros -->
                    <DockPanel Grid.Row="2">
                        <TextBlock x:Name="PreviewSummaryText" DockPanel.Dock="Top" Text="Prévia de Importação:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DataGrid x:Name="PreviewDataGrid" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" RowHeaderWidth="0" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Importar" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" IsReadOnly="True" Width="40"/>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Entry.Name}" IsReadOnly="True" Width="140"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Entry.ClientName}" IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn Header="Grupo" Binding="{Binding Entry.GroupName}" IsReadOnly="True" Width="95"/>
                                <DataGridTextColumn Header="Protocolo" Binding="{Binding Entry.ProtocolDisplay}" IsReadOnly="True" Width="85"/>
                                <DataGridTextColumn Header="Host:Porta" Binding="{Binding Entry.EndpointDisplay}" IsReadOnly="True" Width="135"/>
                                <DataGridTextColumn Header="Usuário" Binding="{Binding Entry.EffectiveUserDisplay}" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn Header="Senha" Binding="{Binding PasswordDisplay}" IsReadOnly="True" Width="75"/>
                                <DataGridTextColumn Header="Campos não recup." Binding="{Binding UnrecoveredFields}" IsReadOnly="True" Width="115"/>
                                <DataGridTextColumn Header="Status / Validação" Binding="{Binding StatusText}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Tratamento de Duplicidades e Botão Confirmar Importação -->
                    <DockPanel Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Se encontrar conexão duplicada:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="DuplicateHandlingCombo" Width="210" SelectedIndex="0" Padding="6,4">
                                <ComboBoxItem Content="Ignorar duplicados"/>
                                <ComboBoxItem Content="Atualizar cadastro existente"/>
                                <ComboBoxItem Content="Criar novo registro"/>
                            </ComboBox>
                        </StackPanel>
                        <Button x:Name="CommitImportButton" Content="✅ Confirmar Importação dos Registros Selecionados"
                                Click="CommitImport_Click" IsEnabled="False" HorizontalAlignment="Right"
                                Padding="14,7" FontWeight="SemiBold" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ABA 2: EXPORTAR & TRANSPORTE CRIPTOGRAFADO -->
            <TabItem Header="📤 Exportar e Pacote Criptografado" Padding="12,6">
                <StackPanel Margin="16">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="1. Exportação Padrão de Cadastros (Sem Senhas)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Exporta todos os servidores cadastrados em UTF-8. Por segurança, nenhuma senha é incluída nos arquivos XML, CSV ou JSON."
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button Content="📄 Exportar para XML (ConectaTI .xml)" Click="ExportXml_Click" Padding="14,7" Margin="0,0,10,10" FontWeight="SemiBold"/>
                                <Button Content="📄 Exportar compatível com AutoPuTTY (.xml)" Click="ExportAutoPuttyXml_Click" Padding="14,7" Margin="0,0,10,10" FontWeight="SemiBold"/>
                                <Button Content="📄 Exportar para CSV (UTF-8)" Click="ExportCsv_Click" Padding="14,7" Margin="0,0,10,10" FontWeight="SemiBold"/>
                                <Button Content="📋 Exportar para JSON (UTF-8)" Click="ExportJson_Click" Padding="14,7" Margin="0,0,10,10" FontWeight="SemiBold"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="2. Transporte Seguro de Cadastros + Credenciais entre Computadores (.ctienc)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Como os dados protegidos por DPAPI são vinculados à conta e máquina Windows locais, utilize este pacote criptografado com senha própria (PBKDF2-SHA256 210.000 iterações + AES-256-GCM) para transportar conexões e credenciais com segurança para outro computador."
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Senha de transporte (mínimo 6 caracteres):" FontSize="12" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="TransportPasswordBox" Padding="6,5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="🔐 Exportar Pacote Criptografado (.ctienc)" Click="ExportEncrypted_Click" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                    <Button Content="🔓 Importar Pacote Criptografado (.ctienc)" Click="ImportEncrypted_Click" Padding="12,6" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <!-- ABA 3: BACKUP E RESTAURAÇÃO DO BANCO SQLITE -->
            <TabItem Header="💾 Backups do Banco SQLite" Padding="12,6">
                <StackPanel Margin="16">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Backup e Restauração Consistentes (SQLite Online Backup API)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="BackupsFolderInfoText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="💾 Criar Backup Agora..." Click="CreateBackup_Click" Padding="14,7" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                <Button Content="♻️ Restaurar a partir de Backup..." Click="RestoreBackup_Click" Padding="14,7" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="BottomStatusText" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <Button Content="Fechar" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="16,6"/>
        </DockPanel>
    </Grid>
</Window>
