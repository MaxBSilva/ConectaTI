<Window x:Class="ConectaTI.App.Views.ImportExportDialog"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        Title="{loc:Loc Text73678BF75065}"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="960" Height="680"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PreviewCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextB6F0955054E9}" FontSize="{DynamicResource Font18}" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text3B0A5A1E174A}"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource Font12}" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl x:Name="ImportTabs" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <!-- ABA 1: IMPORTAR CSV / JSON / AUTOPUTTY -->
            <TabItem Header="{loc:Loc TextBCA6FB12656B}" Padding="12,6">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Seleção de Arquivo -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Left" Content="{loc:Loc Text31FDC4DB1E53}" Click="SelectImportFile_Click"
                                Padding="12,6" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock TextWrapping="Wrap" x:Name="SelectedFileText" Text="{loc:Loc Text21BC7F7BEFE6}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Painel de Mapeamento de Colunas CSV (visível quando um CSV é carregado) -->
                    <Border x:Name="CsvMappingPanel" Grid.Row="1" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text97AE53268AEE}" FontWeight="SemiBold" FontSize="{DynamicResource Font12_5}" Margin="0,0,0,6"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextFB7EE8498663}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapNameCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text56585CE08261}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapClientCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text0E1B7842441A}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapGroupCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextF5AE3AEE593F}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapEnvCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text82EA994D8FE8}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapProtocolCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextEB01DF50C92A}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapHostCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,4">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text579F337DA7DA}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapPortCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text190CCBA7A9C2}" FontSize="{DynamicResource Font11_5}"/>
                                    <ComboBox x:Name="MapUserCombo" SelectionChanged="CsvMappingCombo_SelectionChanged"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Prévia dos Registros -->
                    <DockPanel Grid.Row="2">
                        <TextBlock TextWrapping="Wrap" x:Name="PreviewSummaryText" DockPanel.Dock="Top" Text="{loc:Loc Text0582689D33DD}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DataGrid x:Name="PreviewDataGrid" AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" MinColumnWidth="100" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" GridLinesVisibility="Horizontal" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{loc:Loc TextE7F0E6D956C1}" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="65"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="#" MinWidth="40" Binding="{Binding RowNumber}" IsReadOnly="True" Width="40"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc Text5086900635FE}" Binding="{Binding Entry.Name}" IsReadOnly="True" Width="140"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc TextF851D9A83AB0}" Binding="{Binding Entry.ClientName}" IsReadOnly="True" Width="110"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc Text399B037DAB0F}" Binding="{Binding Entry.GroupName}" IsReadOnly="True" Width="95"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc TextFD399BF6BC7B}" Binding="{Binding Entry.ProtocolDisplay}" IsReadOnly="True" Width="85"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc Text7DD05206EDBD}" Binding="{Binding Entry.EndpointDisplay}" IsReadOnly="True" Width="135"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc TextF53BBAA05FAE}" Binding="{Binding Entry.EffectiveUserDisplay}" IsReadOnly="True" Width="105"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc TextD482C10B3D4D}" Binding="{Binding PasswordDisplay}" IsReadOnly="True" Width="75"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc Text1EF3DC410D8F}" Binding="{Binding UnrecoveredFields}" IsReadOnly="True" Width="115"/>
                                <DataGridTextColumn ElementStyle="{StaticResource PreviewCellText}" Header="{loc:Loc Text43C68567BBA3}" MinWidth="220" Binding="{Binding StatusText}" IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Tratamento de Duplicidades e Botão Confirmar Importação -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextAAE9D86B7B6B}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="DuplicateHandlingCombo" Width="210" SelectedIndex="0" Padding="6,4">
                                <ComboBoxItem Content="{loc:Loc Text0805CA9F38F4}"/>
                                <ComboBoxItem Content="{loc:Loc TextB5F5FA6CC88C}"/>
                                <ComboBoxItem Content="{loc:Loc Text584EC3CBC4BC}"/>
                            </ComboBox>
                        </WrapPanel>
                        <Button x:Name="CommitImportButton" Content="{loc:Loc TextF49A89363BA1}"
                                Click="CommitImport_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,6,0,0"
                                Padding="14,7" FontWeight="SemiBold" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABA 2: EXPORTAR & TRANSPORTE CRIPTOGRAFADO -->
            <TabItem Header="{loc:Loc Text61338C780811}" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Grid x:Name="ExportSelectionPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Text65253DD1CE28}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{loc:Loc Text7AA295080072}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                            <CheckBox Content="{loc:Loc TextE654125E0B1F}" IsChecked="{Binding ExportAll}" Margin="0,0,0,8"/>
                            <WrapPanel><StackPanel Margin="0,0,8,6" Width="220"><TextBlock Text="{loc:Loc Text6894441B3FA5}" TextWrapping="Wrap"/><TextBox Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,8,6" Width="130"><TextBlock Text="{loc:Loc TextF851D9A83AB0}" TextWrapping="Wrap"/><TextBox Text="{Binding Client,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,8,6" Width="130"><TextBlock Text="{loc:Loc Text399B037DAB0F}" TextWrapping="Wrap"/><TextBox Text="{Binding Group,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,8,6" Width="130"><TextBlock Text="{loc:Loc Text0D2B7CA65666}" TextWrapping="Wrap"/><TextBox Text="{Binding Environment,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,8,6" Width="130"><TextBlock Text="{loc:Loc Text5086900635FE}" TextWrapping="Wrap"/><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></WrapPanel>
                            <WrapPanel Margin="0,4,0,8">
                                <Button Content="{loc:Loc Text458E69B2FC40}" Click="SelectFilteredExport_Click" Padding="8,5" Margin="0,0,8,6"/>
                                <Button Content="{loc:Loc Text33A042C0FD07}" Click="ClearExportSelection_Click" Padding="8,5" Margin="0,0,8,6"/>
                                <CheckBox Content="{loc:Loc Text8F7A859AC182}" IsChecked="{Binding ReviewOnly}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding CountText}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <DataGrid x:Name="ExportSelectionGrid" ItemsSource="{Binding Filtered}" Height="210" AutoGenerateColumns="False"
                                CanUserAddRows="False" RowHeaderWidth="0" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="{loc:Loc Text6A57618C2593}" Binding="{Binding IsSelected,UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                                    <DataGridTextColumn Header="{loc:Loc Text5086900635FE}" Binding="{Binding Entry.Name}" IsReadOnly="True" Width="180"/>
                                    <DataGridTextColumn Header="{loc:Loc TextF851D9A83AB0}" Binding="{Binding Entry.ClientName}" IsReadOnly="True" Width="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Text399B037DAB0F}" Binding="{Binding Entry.GroupName}" IsReadOnly="True" Width="140"/>
                                    <DataGridTextColumn Header="{loc:Loc Text0D2B7CA65666}" Binding="{Binding Entry.EnvironmentDisplay}" IsReadOnly="True" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <CheckBox x:Name="IncludePasswordsCheck" Content="{loc:Loc TextA7250A987CAE}" Checked="IncludePasswords_Changed" Unchecked="IncludePasswords_Changed" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Loc Text5B442BB766A7}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <WrapPanel x:Name="ExportPasswordPanel" Visibility="Collapsed">
                                <StackPanel Width="230" Margin="0,0,10,8"><TextBlock Text="{loc:Loc Text3177C57C8E3A}" TextWrapping="Wrap"/><PasswordBox x:Name="TransportPasswordBox" Padding="6,5"/></StackPanel>
                                <StackPanel Width="230" Margin="0,0,0,8"><TextBlock Text="{loc:Loc TextD645EB67E5F9}" TextWrapping="Wrap"/><PasswordBox x:Name="TransportConfirmationBox" Padding="6,5"/></StackPanel>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="{loc:Loc Text8ECB857AC027}" Click="ExportEncrypted_Click" Padding="12,6" Margin="0,0,8,8" FontWeight="SemiBold"/>
                                <Button Content="{loc:Loc Text562A47B9CA3F}" Click="ImportEncrypted_Click" Padding="12,6" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <Expander Header="{loc:Loc TextADB773884997}" Margin="0,8,0,0">
                                <WrapPanel>
                                    <Button Content="{loc:Loc Text4301E713A4E5}" Click="ExportXml_Click" Padding="10,6" Margin="0,0,8,8"/>
                                    <Button Content="{loc:Loc TextC59FA8B7E3AB}" Click="ExportAutoPuttyXml_Click" Padding="10,6" Margin="0,0,8,8"/>
                                    <Button Content="{loc:Loc Text5A753154D30E}" Click="ExportCsv_Click" Padding="10,6" Margin="0,0,8,8"/>
                                    <Button Content="{loc:Loc TextF7ECE35DBD78}" Click="ExportJson_Click" Padding="10,6" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ABA 3: BACKUP E RESTAURAÇÃO DO BANCO SQLITE -->
            <TabItem Header="{loc:Loc TextF63B8E3B6C6F}" Padding="12,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text9FFB8C775A69}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="BackupsFolderInfoText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <WrapPanel>
                                <Button Content="{loc:Loc Text0FEFDA3881D7}" Click="CreateBackup_Click" Padding="14,7" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                <Button Content="{loc:Loc TextDDDE69B0B9C9}" Click="RestoreBackup_Click" Padding="14,7" FontWeight="SemiBold"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar x:Name="ImportProgressBar" Height="5" Margin="0,0,0,6" Visibility="Collapsed"/>
            <TextBlock x:Name="BottomStatusText" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CopyImportErrorsButton" Content="{loc:Loc TextE453736CF3D0}" Click="CopyImportErrors_Click" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
                <Button x:Name="CancelOperationButton" Content="{loc:Loc TextD4B7CE2E6AE1}" Click="CancelOperation_Click" IsEnabled="False" Padding="10,6" Margin="0,0,8,4"/>
                <Button Content="{loc:Loc Text0F2BD88EF0AC}" Click="CloseButton_Click" Padding="16,6" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
