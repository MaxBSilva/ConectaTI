<Window x:Class="ConectaTI.App.Views.ExecutablesSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — ConectaTI"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="760" Height="640"
        MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Configurações" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="Gerencie aparência, programas externos, credenciais e backups."
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12.5" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <!-- ================================================================= -->
            <!-- ABA 1: GERAL (Tema e Área de Transferência)                       -->
            <!-- ================================================================= -->
            <TabItem Header="Geral">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Aparência" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tema do aplicativo" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ThemeModeCombo" SelectionChanged="ThemeModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Conforme o Windows"/>
                                    <ComboBoxItem Content="Tema claro"/>
                                    <ComboBoxItem Content="Tema escuro"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                        <TextBlock Text="Área de Transferência e Automação" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Limpar senha copiada (seg)" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ClipboardClearSecondsBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Ocultar senha exibida (seg)" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="RevealSecondsBox"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="RegisterRdpVaultCheck"
                                  Content="Preencher senha salva automaticamente ao conectar via MSTSC"
                                  Margin="0,0,0,18"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                        <TextBlock Text="Segurança das Credenciais" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="MasterPasswordStatusText"
                                   Text="Protegido pela conta do usuário no Windows (DPAPI)."
                                   FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                        <StackPanel x:Name="MigrationPanel" Visibility="Collapsed">
                            <TextBlock Text="Existe uma senha mestra configurada anteriormente. Deseja migrar suas credenciais para a proteção DPAPI do Windows?"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Senha mestra anterior" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                    <PasswordBox x:Name="CurrentMasterPassBox"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Migrar para DPAPI" Click="MigrateMasterPassword_Click"
                                        VerticalAlignment="Bottom" Padding="14,6"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 2: PROGRAMAS (MSTSC, PuTTY, OpenSSH, WinSCP e VNC)            -->
            <!-- ================================================================= -->
            <TabItem Header="Programas">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Executáveis dos clientes de conexão" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="Detectar automaticamente" Click="AutoDetectButton_Click"
                                    HorizontalAlignment="Right" Padding="12,5"/>
                        </DockPanel>

                        <!-- 1. Área de Trabalho Remota — mstsc.exe -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock Text="Área de Trabalho Remota — mstsc.exe" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MstscValidationText" HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MstscPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Procurar..." Click="BrowseMstsc_Click" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Content="Restaurar caminho padrão" Click="RestoreDefaultMstsc_Click" Margin="6,0,0,0"
                                    ToolTip="Restaura %WINDIR%\System32\mstsc.exe"/>
                        </Grid>

                        <!-- 2. PuTTY -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock Text="PuTTY" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PuttyValidationText" HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PuttyPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Procurar..." Click="BrowsePutty_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 3. OpenSSH -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock Text="OpenSSH" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OpenSshValidationText" HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OpenSshPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Procurar..." Click="BrowseOpenSsh_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 4. WinSCP -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock Text="WinSCP" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WinScpValidationText" HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WinScpPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Procurar..." Click="BrowseWinScp_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 5. VNC -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock Text="VNC" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VncValidationText" HorizontalAlignment="Right" FontSize="11.5" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VncPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="Procurar..." Click="BrowseVnc_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Cliente SSH padrão" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PreferredSshCombo">
                                    <ComboBoxItem Content="PuTTY" Tag="Putty"/>
                                    <ComboBoxItem Content="OpenSSH do Windows" Tag="OpenSsh"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Padrão de parâmetros VNC" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VncFlavorCombo">
                                    <ComboBoxItem Content="TigerVNC / RealVNC (host::porta)" Tag="TigerRealVnc"/>
                                    <ComboBoxItem Content="TightVNC (-host=host -port=porta)" Tag="TightVnc"/>
                                    <ComboBoxItem Content="UltraVNC (host:porta)" Tag="UltraVnc"/>
                                    <ComboBoxItem Content="Personalizado ({host} {port} {user})" Tag="Custom"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Formato personalizado VNC" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="VncTemplateBox"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 3: CREDENCIAIS                                                -->
            <!-- ================================================================= -->
            <TabItem Header="Credenciais">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Credenciais salvas" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Gerencie as senhas e credenciais salvas no aplicativo, incluindo credenciais reutilizadas entre múltiplos servidores."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button Content="Gerenciar credenciais salvas..."
                                Click="OpenCredentialsDialog_Click"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,0,18"/>

                        <!-- Aviso de Portabilidade DPAPI -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="🔒 Aviso Importante sobre Portabilidade de Credenciais (DPAPI)"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="As senhas no ConectaTI são protegidas por padrão pela API nativa do Windows (DPAPI), atrelada exclusivamente ao seu usuário local e a esta máquina física."
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="12"/>
                                <TextBlock Text="Ao copiar o executável ou a pasta do ConectaTI para outro computador ou outro usuário do Windows, os cadastros das conexões continuam funcionando, mas as senhas deverão ser digitadas novamente se você não realizar a exportação com a opção 'Pacote Criptografado (.ctienc)' na aba de Importação e Backup."
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 4: IMPORTAÇÃO E BACKUP                                        -->
            <!-- ================================================================= -->
            <TabItem Header="Importação e backup">
                <StackPanel Margin="20">
                    <TextBlock Text="Importação, exportação e cópias de segurança" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Importe planilhas CSV, arquivos JSON ou listas do AutoPuTTY, exporte seus cadastros e gerencie backups locais do banco de dados."
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <WrapPanel>
                        <Button Content="Abrir importação, exportação e backups..."
                                Click="OpenImportExportDialog_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,8" Margin="0,0,10,8"/>

                        <Button Content="Criar backup agora"
                                Click="CreateQuickBackup_Click"
                                Padding="14,8" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 5: DIAGNÓSTICO                                                -->
            <!-- ================================================================= -->
            <TabItem Header="Diagnóstico">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Diagnóstico do Sistema e Armazenamento" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Informações sobre banco de dados, localização dos arquivos, integridade e logs."
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Caminho efetivo do banco:" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="DiagDbPathText" Grid.Column="1" Text="Carregando..." TextWrapping="Wrap" FontSize="12" FontFamily="Consolas"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Versão do schema SQLite:" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="DiagSchemaVersionText" Grid.Column="1" Text="Carregando..." FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Status da pasta de dados:" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="DiagWritableText" Grid.Column="1" Text="Carregando..." FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Contagem de conexões:" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="DiagCountsText" Grid.Column="1" Text="Carregando..." FontSize="12"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Último erro sanitizado:" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock x:Name="DiagLastErrorText" Grid.Column="1" Text="Nenhum erro registrado." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="📁 Abrir pasta do banco" Click="OpenDatabaseFolder_Click" Padding="14,7" Margin="0,0,8,8"/>
                            <Button Content="📁 Abrir pasta de logs" Click="OpenLogsFolder_Click" Padding="14,7" Margin="0,0,8,8"/>
                            <Button Content="📋 Copiar relatório de diagnóstico" Click="CopyDiagnosticReport_Click" Padding="14,7" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="DialogFeedbackText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="CancelButton_Click" Padding="16,7" Margin="0,0,8,0"/>
                <Button Content="Salvar" Click="SaveButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,7"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
