<Window x:Class="ConectaTI.App.Views.ExecutablesSettingsDialog"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        Title="{loc:Loc Text5ADE38599061}"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="760" Height="640"
        MinWidth="660" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text76B0FB6AD189}" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextED176FEF9943}"
                           Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource Font12_5}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <!-- ================================================================= -->
            <!-- ABA 1: GERAL (Tema e Área de Transferência)                       -->
            <!-- ================================================================= -->
            <TabItem Header="{loc:Loc Text2130A3B5E09E}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text7AE9D418353B}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_SelectionChanged" MaxWidth="650" HorizontalAlignment="Stretch" MinWidth="250" Margin="0,0,0,16">
                            <ComboBoxItem Content="Automático — seguir o idioma do Windows"/>
                            <ComboBoxItem Content="Português (Brasil)"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Español"/>
                        </ComboBox>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextA691DB0557A4}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DensityCombo" SelectionChanged="ViewPreference_Changed" Width="250" HorizontalAlignment="Left" Margin="0,0,0,8"><ComboBoxItem Content="{loc:Loc TextA192EB9E9C8A}"/><ComboBoxItem Content="{loc:Loc TextD42A6DC78356}"/></ComboBox>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text5C4B4BD1A56D}"/>
                        <Slider x:Name="FontSizeSlider" Minimum="11" Maximum="18" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="FontSizeSlider_ValueChanged" MaxWidth="380" HorizontalAlignment="Stretch" Margin="0,4,0,16"/>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text04F9F0A78DBE}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextEB88B483EA19}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ThemeModeCombo" SelectionChanged="ThemeModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Loc TextBBC72DF02AC9}"/>
                                    <ComboBoxItem Content="{loc:Loc Text64B58754485A}"/>
                                    <ComboBoxItem Content="{loc:Loc Text0F1C67EB81A0}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text7A1042B28193}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextEDD837F12E8C}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ClipboardClearSecondsBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text85A1D3DF281D}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBox x:Name="RevealSecondsBox"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="RegisterRdpVaultCheck"
                                  Content="{loc:Loc Text6B93836F2497}"
                                  Margin="0,0,0,18"/>

                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16"/>

                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextBFF5D43C2C6B}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" x:Name="MasterPasswordStatusText"
                                   Text="{loc:Loc Text69FDFD93281A}"
                                   FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,10"/>

                        <Button x:Name="MigratePreviousPasswordsButton" Visibility="Collapsed" Content="{loc:Loc TextC914B1CC0E8A}" Click="MigrateMasterPassword_Click" HorizontalAlignment="Left" Padding="12,6"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 2: PROGRAMAS (MSTSC, PuTTY, OpenSSH, WinSCP e VNC)            -->
            <!-- ================================================================= -->
            <TabItem Header="{loc:Loc Text7B637BAB4F9F}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text1113234D991B}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="{loc:Loc Text6C1F9EBCC8F7}" Click="AutoDetectButton_Click"
                                    HorizontalAlignment="Right" Padding="12,5"/>
                        </DockPanel>

                        <!-- 1. Área de Trabalho Remota — mstsc.exe -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text594C3B2E334A}" FontSize="{DynamicResource Font12_5}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MstscValidationText" HorizontalAlignment="Right" FontSize="{DynamicResource Font11_5}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MstscPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc TextB9D4506C3B66}" Click="BrowseMstsc_Click" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Content="{loc:Loc Text4F67240E9A17}" Click="RestoreDefaultMstsc_Click" Margin="6,0,0,0"
                                    ToolTip="{loc:Loc Text3B7E4699A24A}"/>
                        </Grid>

                        <!-- 2. PuTTY -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextD653A7844124}" FontSize="{DynamicResource Font12_5}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PuttyValidationText" HorizontalAlignment="Right" FontSize="{DynamicResource Font11_5}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PuttyPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc TextB9D4506C3B66}" Click="BrowsePutty_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 3. OpenSSH -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextB34A5D5691AD}" FontSize="{DynamicResource Font12_5}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OpenSshValidationText" HorizontalAlignment="Right" FontSize="{DynamicResource Font11_5}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OpenSshPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc TextB9D4506C3B66}" Click="BrowseOpenSsh_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 4. WinSCP -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text673FA557D7AA}" FontSize="{DynamicResource Font12_5}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WinScpValidationText" HorizontalAlignment="Right" FontSize="{DynamicResource Font11_5}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WinScpPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc TextB9D4506C3B66}" Click="BrowseWinScp_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <!-- 5. VNC -->
                        <DockPanel Margin="0,2,0,3">
                            <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextE41A2B6503B0}" FontSize="{DynamicResource Font12_5}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VncValidationText" HorizontalAlignment="Right" FontSize="{DynamicResource Font11_5}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="VncPathBox" Grid.Column="0" TextChanged="ExecutablePathBox_TextChanged"/>
                            <Button Grid.Column="1" Content="{loc:Loc TextB9D4506C3B66}" Click="BrowseVnc_Click" Margin="6,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextF429B5263082}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PreferredSshCombo">
                                    <ComboBoxItem Content="{loc:Loc TextD653A7844124}" Tag="Putty"/>
                                    <ComboBoxItem Content="{loc:Loc Text2FFCD6F40E95}" Tag="OpenSsh"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text5DE6B45BC540}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VncFlavorCombo">
                                    <ComboBoxItem Content="{loc:Loc Text28EE40536291}" Tag="TigerRealVnc"/>
                                    <ComboBoxItem Content="{loc:Loc Text23E564CAAABA}" Tag="TightVnc"/>
                                    <ComboBoxItem Content="{loc:Loc Text28C0CC7F0976}" Tag="UltraVnc"/>
                                    <ComboBoxItem Content="{loc:Loc Text1DA724AB1F99}" Tag="Custom"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextC62CB625D100}" FontSize="{DynamicResource Font12_5}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="VncTemplateBox"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 3: CREDENCIAIS                                                -->
            <!-- ================================================================= -->
            <TabItem Header="{loc:Loc TextADF9E60F4D90}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc TextD1D6DB3BE482}" FontSize="{DynamicResource Font15}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Text4BF37FF33AA7}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Button Content="{loc:Loc TextF68E4F381086}"
                                Click="OpenCredentialsDialog_Click"
                                HorizontalAlignment="Left"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,0,18"/>

                        <!-- Aviso de Portabilidade DPAPI -->
                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text622599F7B801}"
                                           FontSize="{DynamicResource Font13}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="{loc:Loc TextE683DE8248AB}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="{DynamicResource Font12}"/>
                                <TextBlock Text="{loc:Loc Text215985FC156E}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 4: IMPORTAÇÃO E BACKUP                                        -->
            <!-- ================================================================= -->
            <TabItem Header="{loc:Loc TextEF101CAD23DF}">
                <StackPanel Margin="20">
                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text4A366C8B3706}" FontSize="{DynamicResource Font15}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="{loc:Loc Text6285442CFEFD}"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <WrapPanel>
                        <Button Content="{loc:Loc Text9ECAAA06B087}"
                                Click="OpenImportExportDialog_Click"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Padding="16,8" Margin="0,0,10,8"/>

                        <Button Content="{loc:Loc TextD2DF9DBF7DC0}"
                                Click="CreateQuickBackup_Click"
                                Padding="14,8" Margin="0,0,0,8"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <!-- ================================================================= -->
            <!-- ABA 5: DIAGNÓSTICO                                                -->
            <!-- ================================================================= -->
            <TabItem Header="{loc:Loc TextE695EB16E81F}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Text="{loc:Loc Text877BC3447067}" FontSize="{DynamicResource Font15}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc Text240CF7238558}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Border Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Grid.Column="0" Text="{loc:Loc Text4E8983D8D972}" FontWeight="SemiBold" FontSize="{DynamicResource Font12}"/>
                                    <TextBlock x:Name="DiagDbPathText" Grid.Column="1" Text="{loc:Loc Text1258573B225A}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}" FontFamily="Consolas"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Grid.Column="0" Text="{loc:Loc Text99D46ADA74E4}" FontWeight="SemiBold" FontSize="{DynamicResource Font12}"/>
                                    <TextBlock TextWrapping="Wrap" x:Name="DiagSchemaVersionText" Grid.Column="1" Text="{loc:Loc Text1258573B225A}" FontSize="{DynamicResource Font12}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Grid.Column="0" Text="{loc:Loc Text393F24C49FCC}" FontWeight="SemiBold" FontSize="{DynamicResource Font12}"/>
                                    <TextBlock TextWrapping="Wrap" x:Name="DiagWritableText" Grid.Column="1" Text="{loc:Loc Text1258573B225A}" FontSize="{DynamicResource Font12}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Grid.Column="0" Text="{loc:Loc Text0C7669885EC9}" FontWeight="SemiBold" FontSize="{DynamicResource Font12}"/>
                                    <TextBlock TextWrapping="Wrap" x:Name="DiagCountsText" Grid.Column="1" Text="{loc:Loc Text1258573B225A}" FontSize="{DynamicResource Font12}"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock TextWrapping="Wrap" Grid.Column="0" Text="{loc:Loc Text4E8E952D032B}" FontWeight="SemiBold" FontSize="{DynamicResource Font12}"/>
                                    <TextBlock x:Name="DiagLastErrorText" Grid.Column="1" Text="{loc:Loc Text5B47F14BF7A3}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="{DynamicResource Font12}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="{loc:Loc TextE093EB410320}" Click="OpenDatabaseFolder_Click" Padding="14,7" Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Text425C16F62D4A}" Click="OpenLogsFolder_Click" Padding="14,7" Margin="0,0,8,8"/>
                            <Button Content="{loc:Loc Text75331D5D1612}" Click="CopyDiagnosticReport_Click" Padding="14,7" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="DialogFeedbackText" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc TextBB9DBB406DCB}" Click="CancelButton_Click" Padding="16,7" Margin="0,0,8,0"/>
                <Button Content="{loc:Loc TextAEF7CD5B2081}" Click="SaveButton_Click" Style="{DynamicResource PrimaryButtonStyle}" Padding="20,7"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
