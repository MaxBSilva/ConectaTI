<Window x:Class="ConectaTI.App.Views.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credenciais Salvas Reutilizáveis"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="780" Height="540"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Credenciais Salvas Reutilizáveis" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="Cadastre credenciais compartilhadas por vários servidores de um mesmo cliente. As senhas são armazenadas com proteção vinculada ao usuário do Windows."
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Credenciais -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="+ Nova Credencial" Click="NewCredential_Click" Padding="8,6" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <ListBox x:Name="CredentialsListBox" SelectionChanged="CredentialsListBox_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding EffectiveUserDisplay}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Formulário de Edição da Credencial -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="Dados da Credencial" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Nome / Identificação (ex: Admin Domínio Alfa):" FontSize="12" Margin="0,0,0,2"/>
                    <TextBox x:Name="CredNameBox" Padding="6,5" Margin="0,0,0,8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Usuário:" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox x:Name="CredUserBox" Padding="6,5" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Domínio (opcional):" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox x:Name="CredDomainBox" Padding="6,5" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Senha (deixe em branco ao editar para manter a senha atual):" FontSize="12" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="CredPasswordBox" Padding="6,5" Margin="0,0,0,8"/>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="RevealedSecretBox" Text="Senha salva: ••••••••••••" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12.5"/>
                        <Button Content="👁 Revelar Temporariamente" Click="RevealCredPassword_Click" HorizontalAlignment="Right" Padding="8,4"/>
                    </DockPanel>

                    <TextBlock Text="Observações:" FontSize="12" Margin="0,0,0,2"/>
                    <TextBox x:Name="CredNotesBox" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Padding="6,5" Margin="0,0,0,12" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Excluir Credencial" Click="DeleteCredential_Click" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="Salvar Credencial" Click="SaveCredential_Click" Padding="14,6" FontWeight="SemiBold"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <Button Content="Fechar" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="16,6"/>
        </DockPanel>
    </Grid>
</Window>
