<Window x:Class="ConectaTI.App.Views.CredentialsDialog"
        FontSize="{DynamicResource AppFontSize}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ConectaTI.App.Localization"
        Title="{loc:Loc Text505B2AD89124}"
        Icon="pack://application:,,,/ConectaTI;component/Assets/conectati.ico"
        Width="780" Height="540"
        MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{loc:Loc Text505B2AD89124}" FontSize="{DynamicResource Font17}" FontWeight="Bold"/>
            <TextBlock Text="{loc:Loc Text0EB22940AE07}"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="{DynamicResource Font12}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Credenciais -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Top" Content="{loc:Loc Text9627552FAEAE}" Click="NewCredential_Click" Padding="8,6" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <ListBox x:Name="CredentialsListBox" SelectionChanged="CredentialsListBox_SelectionChanged"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding EffectiveUserDisplay}" FontSize="{DynamicResource Font11_5}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Formulário de Edição da Credencial -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <StackPanel>
                    <TextBlock Text="{loc:Loc TextC6A682B06524}" FontSize="{DynamicResource Font14}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="{loc:Loc Text8A9E5ED513D0}" FontSize="{DynamicResource Font12}" Margin="0,0,0,2"/>
                    <TextBox x:Name="CredNameBox" Padding="6,5" Margin="0,0,0,8" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="{loc:Loc Text57EBFE7D2AF5}" FontSize="{DynamicResource Font12}" Margin="0,0,0,2"/>
                            <TextBox x:Name="CredUserBox" Padding="6,5" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="{loc:Loc TextF31F0C0D3463}" FontSize="{DynamicResource Font12}" Margin="0,0,0,2"/>
                            <TextBox x:Name="CredDomainBox" Padding="6,5" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{loc:Loc Text9ED98A224A5A}" FontSize="{DynamicResource Font12}" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="CredPasswordBox" Padding="6,5" Margin="0,0,0,8"/>

                    <TextBlock x:Name="StorageText" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="RevealedSecretBox" Text="{loc:Loc TextEF31BC5F6E5E}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="{DynamicResource Font12_5}"/>
                        <Button Content="{loc:Loc TextDF42F6785A38}" Click="RevealCredPassword_Click" HorizontalAlignment="Right" Padding="8,4"/>
                    </DockPanel>

                    <TextBlock Text="{loc:Loc TextEED46B88EF57}" FontSize="{DynamicResource Font12}" Margin="0,0,0,2"/>
                    <TextBox x:Name="CredNotesBox" Height="65" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Padding="6,5" Margin="0,0,0,12" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:Loc Text6B94E07B7879}" Click="DeleteCredential_Click" Padding="10,6" Margin="0,0,8,0"/>
                        <Button Content="{loc:Loc Text2F06521E1324}" Click="SaveCredential_Click" Padding="14,6" FontWeight="SemiBold"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
            <Button Content="{loc:Loc Text0F2BD88EF0AC}" Click="CloseButton_Click" HorizontalAlignment="Right" Padding="16,6"/>
        </DockPanel>
    </Grid>
</Window>
